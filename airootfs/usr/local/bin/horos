#!/usr/bin/env bash
# HorOS Linux — tty1'de systemd tarafından başlatılır (getty@tty1 drop-in'i).
# Ağ bekleme, banner vb. yok: installer hemen açılır; ağ ve konum arka planda denetlenir.
# Not: bilinçli olarak "set -e" yok; bir adım hata verirse kurulum ekranı kapanmasın.
set -uo pipefail

printf '\e[?25h'   # vt.global_cursor_default=0 ile gizlenen imleci geri aç

while true; do
  /usr/local/bin/horos-installer
  rc=$?

  # Bitti / iptal / hata: kısa sonuç menüsü
  echo
  if (( rc == 0 )); then
    echo "Kurulum tamamlandı. USB/ISO'yu çıkarıp yeniden başlat."
  elif (( rc == 130 )); then
    echo "Kurulum iptal edildi."
  else
    echo "Kurulum tamamlanmadı (kod: $rc)."
  fi
  echo "  [Enter] Yeniden başlat   [t] Tekrar dene   [n] Ağ   [k] Kapat   [s] Kabuk"
  read -rp "> " a || { sleep 1; continue; }
  case "${a,,}" in
    ""|r) systemctl reboot ;;
    t)    continue ;;
    n)    nmtui || true ;;
    k)    systemctl poweroff ;;
    s|shell) bash ;;   # çıkınca kurulum yeniden açılır
  esac
done
