#!/usr/bin/env bash
# HorOS Linux — terminal menüsü
# Not: bilinçli olarak "set -e" yok; bir alt komut hata verirse menü kapanmasın.
set -uo pipefail

show_banner() {
  clear
  cat <<'BANNER'
 _   _            ___  ____
| | | | ___  _ __/ _ \/ ___|
| |_| |/ _ \| '__| | | \___ \
|  _  | (_) | |  | |_| |___) |
|_| |_|\___/|_|   \___/|____/

          HorOS Linux
BANNER
}

while true; do
  show_banner
  echo
  echo "1) Live terminal"
  echo "2) Kullanıcı oluştur (Live)"
  echo "3) HorOS'u diske kur"
  echo "4) Yeniden başlat"
  echo "5) Kapat"
  echo
  read -rp "Seçim [1-5]: " choice || { sleep 1; continue; }
  case "$choice" in
    1) exec bash ;;
    2) /usr/local/bin/horos-user; echo; read -rp "Devam etmek için Enter'a bas..." _ || true ;;
    3) /usr/local/bin/horos-installer; echo; read -rp "Devam etmek için Enter'a bas..." _ || true ;;
    4) systemctl reboot ;;
    5) systemctl poweroff ;;
    *) echo "Geçersiz seçim"; sleep 1 ;;
  esac
done
