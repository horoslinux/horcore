#!/usr/bin/env bash
# HorOS Linux — tty1'de systemd tarafından başlatılır (getty@tty1 drop-in'i).
# Kurulum arayüzü whiptail TUI'dir; eski CLI özet menüsü kullanılmaz.
# Not: bilinçli olarak "set -e" yok; bir adım hata verirse kurulum ekranı kapanmasın.
set -uo pipefail

# Plymouth'u initramfs'tan beri açık tuttuk (plymouth-quit override'ı).
# Splash'ı tam bu noktada kapatıyoruz; arayüz hemen çizileceği için siyah
# geçiş olmuyor ve spinner -> TUI animasyonu kesintisiz devam ediyor.
if command -v plymouth >/dev/null 2>&1; then
  plymouth quit >/dev/null 2>&1 || true
fi

printf '\e[?25h'   # imleci görünür yap

INSTALLER="/usr/local/bin/horos-installer-tui"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
THEME_LIB="${HOROS_THEME_LIB:-$SCRIPT_DIR/horos-tui-theme}"
if [[ -r "$THEME_LIB" ]]; then
  # shellcheck source=horos-tui-theme
  source "$THEME_LIB"
else
  horos_theme() { :; }
fi
horos_theme

result_menu() { # $1 mesaj; whiptail yoksa/iptal edilirse 1 döner
  local msg="$1" a
  command -v whiptail >/dev/null 2>&1 || return 1
  a="$(whiptail --title "HorOS Kurulumu" --menu "$msg" 17 72 5 \
    "r" "Yeniden başlat" \
    "t" "Tekrar dene" \
    "n" "Ağ ayarlarını aç (nmtui)" \
    "k" "Kapat" \
    "s" "Kabuk" 3>&1 1>&2 2>&3)" || return 1
  a="${a#\"}"; a="${a%\"}"
  [[ -n "$a" ]] || return 1
  printf '%s' "$a"
}

while true; do
  "$INSTALLER"
  rc=$?

  # Bitti / iptal / hata: kısa sonuç menüsü
  if (( rc == 0 )); then
    msg="Kurulum tamamlandı.\nUSB/ISO'yu çıkarıp yeniden başlatabilirsin."
  elif (( rc == 130 )); then
    msg="Kurulum iptal edildi."
  elif (( rc == 99 )); then
    msg="Kurulum için bazı bilgiler eksik.\nAğ, hedef disk ve yönetici hesabını denetleyip tekrar dene."
  else
    msg="Kurulum tamamlanmadı (kod: $rc)."
  fi

  if ! a="$(result_menu "$msg")"; then
    echo
    echo -e "$msg"
    echo "  [Enter] Yeniden başlat   [t] Tekrar dene   [n] Ağ   [k] Kapat   [s] Kabuk"
    read -rp "> " a || { sleep 1; continue; }
  fi

  case "${a,,}" in
    ""|r) systemctl reboot ;;
    t)    continue ;;
    n)    nmtui || true ;;
    k)    systemctl poweroff ;;
    s|shell) bash ;;   # çıkınca kurulum yeniden açılır
  esac
done
