#!/usr/bin/env bash
# HorOS Linux — açılışta doğrudan kurulum (menü yok)
# Not: bilinçli olarak "set -e" yok; bir adım hata verirse kurulum ekranı kapanmasın.
set -uo pipefail

show_banner() {
  clear
  cat <<'BANNER'
 _   _            ___  ____
| | | | ___  _ __/ _ \/ ___|
| |_| |/ _ \| '__| | | \___ \
|  _  | (_) | |  | |_| |___) |
|_| |_|\___/|_|   \___/|____/

          HorOS Linux
BANNER
  echo
}

have_net() { ping -c1 -W3 archlinux.org &>/dev/null; }

# 1) Ağ: bağlantı yoksa Wi-Fi/kablolu ayarını otomatik aç
ensure_network() {
  local i
  for i in 1 2 3 4 5; do   # DHCP'nin gelmesi için kısa bekleme
    have_net && return 0
    sleep 1
  done
  echo "İnternet bağlantısı yok. Ağ ayarı açılıyor (Wi-Fi için)..."
  sleep 1
  nmtui || true
}

while true; do
  show_banner
  ensure_network

  # 2) Kurulum: profil seçimi -> ön ayarlar -> archinstall
  /usr/local/bin/horos-installer
  rc=$?

  # 3) Bitti / iptal / hata: kısa sonuç menüsü
  echo
  if (( rc == 0 )); then
    echo "Kurulum tamamlandı. USB/ISO'yu çıkarıp yeniden başlat."
  elif (( rc == 130 )); then
    echo "Kurulum iptal edildi."
  else
    echo "Kurulum tamamlanmadı (kod: $rc)."
  fi
  echo "  [Enter] Yeniden başlat   [t] Tekrar dene   [n] Ağ   [k] Kapat   [s] Kabuk"
  read -rp "> " a || { sleep 1; continue; }
  case "${a,,}" in
    ""|r) systemctl reboot ;;
    t)    continue ;;
    n)    nmtui || true ;;
    k)    systemctl poweroff ;;
    s|shell) exec bash ;;
  esac
done
