#!/usr/bin/env bash
# HorOS Linux — whiptail tabanlı kurulum sihirbazı.
# Arka uç (archinstall config, marka dosyaları, önyükleme doğrulaması)
# horos-installer-core içinde; bu dosya yalnızca akışı ve ekranları sağlar.
set -uo pipefail
export LC_ALL=C.UTF-8

TITLE="HorOS Kurulumu"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="${HOROS_INSTALLER_BACKEND:-$SCRIPT_DIR/horos-installer-core}"
DRYRUN="${HOROS_DRYRUN:-}"

THEME_LIB="${HOROS_THEME_LIB:-$SCRIPT_DIR/horos-tui-theme}"
if [[ -r "$THEME_LIB" ]]; then
  # shellcheck source=horos-tui-theme
  source "$THEME_LIB"
else
  horos_theme() { :; }
fi
horos_theme

# Arka uç saf kütüphanedir; tüm yardımcılar ve durum değişkenleri bu kabuğa yüklenir.
# whiptail yalnızca çalışma zamanında gerekir; arka uç her durumda yüklenmelidir.
[[ -r "$BACKEND" ]] || { echo "$BACKEND bulunamadı." >&2; exit 1; }
# shellcheck source=horos-installer-core
source "$BACKEND"

# ------------------------------------------------------------------ TUI yardımcıları
check_ui() {
  command -v whiptail >/dev/null 2>&1 || {
    echo "whiptail bulunamadı. ISO'ya 'libnewt' paketini ekle." >&2
    exit 1
  }
}

abort() { echo "Kurulum iptal edildi." >&2; exit 130; }

info() { # $1 mesaj, $2 yükseklik, $3 genişlik
  whiptail --title "$TITLE" --msgbox "$1" "${2:-10}" "${3:-70}"
}

confirm() { # $1 mesaj, $2 yükseklik, $3 genişlik
  whiptail --title "$TITLE" --yesno "$1" "${2:-12}" "${3:-70}" --defaultno
}

pick() { # whiptail çıktısını stdout'a verir; iptal/ESC -> 1
  local out
  out="$(whiptail --title "$TITLE" "$@" 3>&1 1>&2 2>&3)" || return 1
  out="${out#\"}"; out="${out%\"}"
  printf '%s' "$out"
}

# ------------------------------------------------------------------ 1) Ağ
set_hostname_tui() {
  local h
  while true; do
    h="$(pick --inputbox "Makine adı (küçük harf, rakam ve '-'):" 10 60 "$hostname_v")" || return 0
    if [[ "$h" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
      hostname_v="$h"
      return 0
    fi
    info "Geçersiz ad. Örnek: horos-pc"
  done
}

# ------------------------------------------------------------------ Wi-Fi (kolay mod)
# nmtui'ye göndermeden tarama + seçim + parola akışını whiptail içinde yapar.
wifi_iface() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }'
}

wifi_is_connected() { # $1 aygıt
  local state
  state="$(nmcli -t -f DEVICE,STATE device status 2>/dev/null | awk -F: -v d="$1" '$1 == d { print $2; exit }')"
  [[ "$state" == "connected" ]]
}

wifi_connect_once() { # $1 aygıt, $2 SSID, $3 parola (opsiyonel)
  local iface="$1" ssid="$2" pass="${3-}" out rc
  if [[ -n "$pass" ]]; then
    out="$(nmcli device wifi connect "$ssid" password "$pass" ifname "$iface" 2>&1)"; rc=$?
  else
    out="$(nmcli device wifi connect "$ssid" ifname "$iface" 2>&1)"; rc=$?
  fi
  if (( rc != 0 )); then
    printf '%s\n' "$out"
    return 1
  fi
  # nmcli bağlantıyı kurarken IP'yi bekler; yine de kısa bir doğrulama yap.
  for _ in 1 2 3; do
    wifi_is_connected "$iface" && return 0
    sleep 1
  done
  printf '%s\n' "${out:-Bağlantı kuruldu ancak aygıt hazır olmadı.}"
  return 1
}

wifi_connect_tui() {
  local iface line rest ssid sig sec inuse choice pass out
  local -a rows=() items=() ssids=() secs=() args=()
  local i=0

  iface="$(wifi_iface)"
  if [[ -z "$iface" ]]; then
    info "Bu makinede Wi-Fi aygıtı bulunamadı.\nEthernet bağlıysa doğrudan devam edebilirsin." 10 68
    return 0
  fi
  nmcli radio wifi on >/dev/null 2>&1 || true

  while true; do
    mapfile -t rows < <(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list ifname "$iface" --rescan auto 2>/dev/null)
    items=(); ssids=(); secs=(); i=0
    for line in "${rows[@]}"; do
      [[ -n "$line" ]] || continue
      # SSID'nin içinde ':' olabilir; sağdan SIGNAL/SECURITY'yi ayır, kalanı SSID yap.
      inuse="${line%%:*}"; rest="${line#*:}"
      sec="${rest##*:}"; rest="${rest%:*}"
      sig="${rest##*:}"; ssid="${rest%:*}"
      [[ -n "$ssid" ]] || continue   # gizli ağlar listeye girmez
      i=$((i + 1))
      items+=("$i" "$(printf '%-26.26s  %3s%%  %-8.8s%s' "$ssid" "${sig:-0}" "${sec:---}" "${inuse:+  *}")")
      ssids[$i]="$ssid"; secs[$i]="$sec"
    done

    args=(--menu "Wi-Fi ağı seç ($iface)\n\n* = şu an bağlı olunan ağ\nSinyal yüzdesi ve güvenlik türü gösterilir." 22 76 12)
    (( i > 0 )) && args+=("${items[@]}")
    args+=(
      r "Listeyi yeniden tara"
      m "Ağ adını elle yaz (gizli ağ)"
      n "nmtui ile gelişmiş ayarlar"
      b "Geri dön"
    )
    choice="$(pick "${args[@]}")" || return 0

    case "$choice" in
      r) continue ;;
      b) return 0 ;;
      n) nmtui || true; return 0 ;;
      m)
        ssid="$(pick --inputbox "Ağ adı (SSID):" 9 62)" || continue
        [[ -n "$ssid" ]] || continue
        sec="WPA"
        ;;
      *)
        ssid="${ssids[10#$choice]-}"
        sec="${secs[10#$choice]-}"
        [[ -n "$ssid" ]] || continue
        ;;
    esac

    # Açık ağ veya kayıtlı profil: parola sormadan dene.
    if out="$(wifi_connect_once "$iface" "$ssid" 2>&1)"; then
      net_state="Bağlı"
      info "Bağlandı: $ssid\n\nAğ durumu güncellendi; kuruluma devam edebilirsin." 10 68
      return 0
    fi

    # Parola korumalı ağ: ilk deneme kayıtlı profille başarısız oldu.
    if [[ "$sec" != "--" && -n "$sec" ]]; then
      pass="$(pick --passwordbox "\"$ssid\" parolası (en az 8 karakter):" 10 72)" || continue
      if (( ${#pass} < 8 )); then
        info "Wi-Fi parolası en az 8 karakter olmalı."; continue
      fi
      if out="$(wifi_connect_once "$iface" "$ssid" "$pass" 2>&1)"; then
        net_state="Bağlı"
        info "Bağlandı: $ssid\n\nAğ durumu güncellendi; kuruluma devam edebilirsin." 10 68
        return 0
      fi
    fi

    info "Bağlanamadı: $ssid\n\n$(printf '%s' "$out" | tail -n 6)\n\nSSID/parolayı denetleyip tekrar dene." 14 76
  done
}

step_network() {
  local choice msg
  local -a args=()
  while true; do
    if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
    msg="Kurulum için internet bağlantısı gerekir.\n\nAğ durumu : $net_state\nMakine adı: $hostname_v\n\nWi-Fi için ağ seçip parolayı yazman yeterli; gelişmiş ayarlar nmtui'de."
    args=()
    [[ "$net_state" != "Bağlı" ]] && args+=(--default-item 2)
    args+=(
      --menu "$msg" 19 74 5
      "1" "Ağ durumunu yeniden denetle"
      "2" "Wi-Fi ağına bağlan (kolay)"
      "3" "Ağı yapılandır (nmtui — gelişmiş)"
      "4" "Makine adını ayarla ($hostname_v)"
      "5" "Devam et"
    )
    choice="$(pick "${args[@]}")" || abort
    case "$choice" in
      1) continue ;;
      2) wifi_connect_tui ;;
      3) nmtui || true; continue ;;
      4) set_hostname_tui ;;
      5) return 0 ;;
      *) abort ;;
    esac
  done
}

# ------------------------------------------------------------------ 2) IP'den bölge/dil
detect_locale_from_ip() {
  local tz="" c="" kb2="" l2=""
  if have_net; then
    tz="$(ip_lookup timezone || true)"
    c="$(ip_lookup country || true)"
  fi
  if [[ -n "$tz" && -f "/usr/share/zoneinfo/$tz" ]]; then
    timezone="$tz"; tz_src="IP'den tespit edildi"
  fi
  if [[ "$c" =~ ^[A-Z]{2}$ ]]; then
    country="$c"
    kb2="$(keymap_for_country "$c")"
    if keymap_exists "$kb2"; then kb="$kb2"; fi
    l2="$(locale_for_country "$c")"
    locale_exists "$l2" && lang="$l2"
    lang_src="IP'den tespit edildi ($c)"
  fi
  if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
}

tui_keyboard() {
  local k
  while true; do
    k="$(pick --inputbox "Klavye düzeni (örn: us, trq, trf, uk, de-latin1):" 10 66 "$kb")" || return 0
    if keymap_exists "$k"; then
      kb="$k"; kb_ok=1
      loadkeys "$kb" 2>/dev/null || true
      return 0
    fi
    info "'$k' bulunamadı. Tüm düzenler için: localectl list-keymaps"
  done
}

tui_timezone() {
  local z matches
  while true; do
    z="$(pick --inputbox "Saat dilimi (örn: Europe/Istanbul, UTC; arama: ist):" 10 70 "$timezone")" || return 0
    if [[ "$z" =~ ^[A-Za-z0-9_+/-]+$ && -f "/usr/share/zoneinfo/$z" ]]; then
      timezone="$z"; tz_src="elle seçildi"
      return 0
    fi
    matches="$(timedatectl list-timezones 2>/dev/null | grep -i -- "${z//[^A-Za-z0-9_+\/-]/}" | head -n 8 | tr '\n' ' ')"
    info "Bulunamadı. Eşleşenler:\n${matches:-yok}\n\nÖrnek: Europe/Istanbul"
  done
}

tui_language() {
  local l
  while true; do
    l="$(pick --inputbox "Sistem dili (örn: tr_TR, en_US, de_DE):" 10 66 "$lang")" || return 0
    if locale_exists "$l"; then
      lang="$l"; lang_src="elle seçildi"
      return 0
    fi
    info "Bu locale /etc/locale.gen içinde yok.\nÖrnek: tr_TR, en_US, de_DE, fr_FR"
  done
}

step_locale() {
  local choice msg
  detect_locale_from_ip
  while true; do
    msg="IP adresinden tespit edilen ayarlar:\n\nKlavye düzeni : $kb\nSaat dilimi   : $timezone\nDil           : $lang\n\nKaynak: ${country:-bilinmiyor} · $lang_src"
    choice="$(pick --menu "$msg" 17 72 5 \
      "1" "Klavye düzenini değiştir ($kb)" \
      "2" "Saat dilimini değiştir ($timezone)" \
      "3" "Dili değiştir ($lang)" \
      "4" "IP tespitini yeniden çalıştır" \
      "5" "Onayla ve devam et")" || abort
    case "$choice" in
      1) tui_keyboard ;;
      2) tui_timezone ;;
      3) tui_language ;;
      4) detect_locale_from_ip ;;
      5) kb_ok=1; loadkeys "$kb" 2>/dev/null || true; return 0 ;;
      *) abort ;;
    esac
  done
}

# ------------------------------------------------------------------ 3) Profil / masaüstü
step_desktop() {
  local d
  d="$(pick --radiolist "Masaüstü ortamı (yalnızca Workstation):" 15 68 3 \
    "none"   "Kurma — yalnızca terminal" off \
    "kde"    "KDE Plasma" on \
    "gnome"  "GNOME" off)" || abort
  case "$d" in
    none)  desktop="" ;;
    kde)   desktop=kde ;;
    gnome) desktop=gnome ;;
    *)     abort ;;
  esac
}

step_software() {
  local profiles=() items=() p i=0 pc
  mapfile -t profiles < <(find "$PROFILE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name common -printf '%f\n' 2>/dev/null | sort)
  (( ${#profiles[@]} > 0 )) || { info "Profil bulunamadı: $PROFILE_DIR"; abort; }
  for p in "${profiles[@]}"; do
    i=$((i + 1))
    items+=("$i" "$(profile_title "$p")")
  done
  pc="$(pick --menu "Kurulum profilini seç:" 18 76 "${#profiles[@]}" "${items[@]}")" || abort
  profile="${profiles[10#$pc - 1]}"
  if [[ "$profile" == workstation ]]; then
    step_desktop
  else
    desktop=""
  fi
}

# ------------------------------------------------------------------ 4) Root / kullanıcı
tui_password() { # $1 etiket; PW_HASH globalini doldurur
  local label="$1" p1 p2
  while true; do
    p1="$(pick --passwordbox "Parola ($label; en az 8 karakter, boş = vazgeç):" 10 72)" || return 1
    [[ -n "$p1" ]] || return 1
    if (( ${#p1} < 8 )); then info "En az 8 karakter olmalı."; continue; fi
    p2="$(pick --passwordbox "Parolayı tekrar yaz ($label):" 10 72)" || return 1
    [[ "$p1" == "$p2" ]] && break
    info "Parolalar eşleşmiyor."
  done
  PW_HASH="$(printf '%s' "$p1" | openssl passwd -6 -stdin)" || return 1
  [[ "$PW_HASH" == '$6$'* ]]
}

step_accounts() {
  local choice u admin
  while true; do
    choice="$(pick --radiolist "Root hesabı:" 14 70 2 \
      "lock" "Kilitli (önerilen; sudo'lu kullanıcı ile yönet)" on \
      "pass" "Root parolası belirle" off)" || abort
    if [[ "$choice" == "pass" ]]; then
      tui_password "root" || { info "Root parolası alınamadı."; continue; }
      root_hash="$PW_HASH"
    else
      root_hash=""
    fi

    u="$(pick --inputbox "Kullanıcı adı (boş = kullanıcı oluşturma):" 10 68 "")" || abort
    username=""; user_hash=""; user_admin=1
    if [[ -n "$u" ]]; then
      if [[ ! "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ || "$u" == root ]]; then
        info "Geçersiz kullanıcı adı.\nKüçük harf, rakam, '_' ve '-' kullan; 'root' kullanılamaz."
        continue
      fi
      tui_password "kullanıcı $u" || { info "Parola alınamadı."; continue; }
      user_hash="$PW_HASH"
      admin="$(pick --radiolist "Yönetici (sudo) yetkisi?" 12 62 2 \
        "yes" "Evet — wheel grubuna ekle" on \
        "no"  "Hayır" off)" || abort
      if [[ "$admin" == "yes" ]]; then user_admin=1; else user_admin=0; fi
      username="$u"
    fi

    if admin_ok; then return 0; fi
    info "Root kilitli ve sudo'lu kullanıcı yok.\nEn az bir yönetici hesabı gerekli."
  done
}

# ------------------------------------------------------------------ 5) Disk
# Mevcut bir bölümü kök olarak seçer; ESP varsa korunup /boot olarak bağlanır.
select_existing_partition_tui() {
  local dev="$1" choice l pdev psz pfs plabel esp esp_fs
  local -a lines=() items=()
  while true; do
    mapfile -t lines < <(list_partitions "$dev")
    if (( ${#lines[@]} == 0 )); then
      info "Bu diskte bölüm bulunamadı." 10 68
      return 1
    fi
    items=()
    for l in "${lines[@]}"; do
      IFS=$'\t' read -r pdev psz pfs plabel <<<"$l"
      items+=("$pdev" "${pdev##*/}  $(human_size "$psz")  $pfs  $plabel")
    done
    choice="$(pick --menu "Formatlanacak bölümü seç ($dev):\n\nDiğer bölümlere dokunulmaz." 19 78 "${#lines[@]}" "${items[@]}")" || return 1
    confirm "UYARI: $choice içindeki TÜM VERİLER SİLİNECEK.\n\nBu bölüm ext4 olarak formatlanıp HorOS kökü olacak.\nDevam edilsin mi?" 13 76 || continue

    existing_part="$choice"
    existing_esp=""
    mapfile -t esp < <(find_esp_dev "$dev")
    if (( ${#esp[@]} > 0 )); then
      IFS=$'\t' read -r existing_esp esp_fs <<<"${esp[0]}"
    fi
    if is_efi && [[ -z "$existing_esp" ]]; then
      info "UEFI için EFI/boot bölümü bulunamadı.\nBu modda önyükleyici kurulamaz; başka bir yöntem seç." 11 72
      return 1
    fi
    if [[ -n "$existing_esp" && "$existing_esp" == "$choice" ]]; then
      info "Seçilen bölüm EFI/boot bölümü. Kök olarak kullanılamaz.\nFarklı bir bölüm seç." 10 72
      continue
    fi
    if [[ -n "$existing_esp" ]]; then
      info "EFI/boot bölümü formatlanmadan /boot olarak bağlanacak:\n$existing_esp" 10 72
    fi
    return 0
  done
}

step_disk() {
  local lines=() items=() spaces=() sitems=() l i=0 pc name size model sec pm psz psz_gb plan
  local st sz chosen_start
  mapfile -t lines < <(list_disks)
  (( ${#lines[@]} > 0 )) || { info "Kurulabilecek disk bulunamadı."; abort; }

  for l in "${lines[@]}"; do
    i=$((i + 1))
    IFS=$'\t' read -r name size model sec <<<"$l"
    items+=("$i" "$name  $(human_size "$size")  $model")
  done
  pc="$(pick --menu "Kurulum hedefini seç (kurulum ortamı gizlendi):" 18 78 "${#lines[@]}" "${items[@]}")" || abort
  IFS=$'\t' read -r name size model sec <<<"${lines[10#$pc - 1]}"
  if (( size < 8 * 1024 * 1024 * 1024 )); then
    info "Disk çok küçük (en az 8 GB gerekir)."; abort
  fi

  while true; do
    pm="$(pick --radiolist "Bölümleme yöntemi:" 16 80 3 \
      "full"     "Tüm diski sil ve otomatik bölümlendir" on \
      "partial"  "Mevcut bölümleri koru, boş alana kur" off \
      "existing" "Mevcut bölümü kullan (FORMATLANIR — diğerleri korunur)" off)" || abort

    if [[ "$pm" == "partial" ]]; then
      while true; do
        psz="$(pick --inputbox "Ayrılacak alan GB [100] (örn: 20, 20G, 100GB):" 10 72 "100")" || abort
        psz="${psz//[[:space:]]/}"
        [[ -z "$psz" ]] && psz="100"
        psz_gb="${psz^^}"
        psz_gb="${psz_gb%GIB}"; psz_gb="${psz_gb%GB}"; psz_gb="${psz_gb%G}"
        if [[ ! "$psz_gb" =~ ^[0-9]+$ || ${#psz_gb} -gt 6 ]] || (( 10#$psz_gb < 8 )); then
          info "Geçersiz boyut. En az 8 GB; örnek: 20, 20G veya 100GB."
          continue
        fi
        psz=$(( 10#$psz_gb * 1024 ))   # MiB
        if (( psz > size / 1024 / 1024 )); then
          info "İstenen alan disk boyutundan büyük."
          continue
        fi
        # Kullanılabilir boş alanları listele; birden fazla varsa kullanıcı seçer.
        mapfile -t spaces < <(list_partial_spaces "$name")
        if (( ${#spaces[@]} == 0 )); then
          info "Bu diskte en az 8 GB'lık boş alan yok.\nVar olan bir bölümü küçültüp boş alan oluşturman gerekiyor."
          continue
        fi
        chosen_start=""
        if (( ${#spaces[@]} > 1 )); then
          sitems=()
          for l in "${spaces[@]}"; do
            IFS=$'\t' read -r st sz <<<"$l"
            sitems+=("$st" "${st} MiB konumundan $(( sz / 1024 )) GB boş alan")
          done
          chosen_start="$(pick --menu "Boş alan seç ($name):" 18 74 "${#spaces[@]}" "${sitems[@]}")" || abort
        else
          IFS=$'\t' read -r chosen_start sz <<<"${spaces[0]}"
        fi
        if ! plan="$(find_partial_plan "$name" "$psz" "$chosen_start")"; then
          info "Seçilen boş alan planlanamadı.\nFarklı bir alan veya boyut dene."
          continue
        fi
        IFS=$'\t' read -r partial_start partial_size partial_esp partial_esp_start partial_esp_size partial_esp_fs <<<"$plan"
        disk_mode="partial"
        existing_part=""; existing_esp=""
        info "Plan: ${partial_start} MiB konumundan ${partial_size} MiB ($(( partial_size / 1024 )) GB) kullanılacak.\nEFI/boot: ${partial_esp:-bu alanın içinde yeni oluşturulacak}" 12 76
        break
      done
      break
    elif [[ "$pm" == "existing" ]]; then
      if select_existing_partition_tui "$name"; then
        disk_mode="existing"
        break
      fi
      continue
    else
      disk_mode="full"
      partial_start=0; partial_size=0
      partial_esp=""; partial_esp_start=0; partial_esp_size=0; partial_esp_fs="fat32"
      existing_part=""; existing_esp=""
      break
    fi
  done
  disk="$name"; disk_bytes="$size"; disk_sec="$sec"
}

# ------------------------------------------------------------------ 6) Takas
step_swap() {
  local a v
  a="$(pick --radiolist "Takas (swap) alanı:" 14 70 2 \
    "on"  "Etkin — ${swap_mib} MiB swapfile" on \
    "off" "Kapalı" off)" || abort
  if [[ "$a" == "off" ]]; then swap_on=0; return 0; fi
  swap_on=1
  while true; do
    v="$(pick --inputbox "Swap boyutu MiB [${swap_mib}] (0 = RAM'e göre otomatik):" 11 74 "$swap_mib")" || abort
    [[ -z "$v" ]] && v="$swap_mib"
    if [[ ! "$v" =~ ^[0-9]+$ ]]; then info "Geçersiz sayı."; continue; fi
    v=$((10#$v))
    if (( v == 0 )); then swap_mib="$(swap_size_for_ram)"; return 0; fi
    if (( v >= 256 && v <= 65536 )); then swap_mib="$v"; return 0; fi
    info "256 ile 65536 MiB arasında bir değer gir (veya 0 = otomatik)."
  done
}

# ------------------------------------------------------------------ 7) Son onay
step_final() {
  local disk_v warn root_v user_v text
  if [[ -n "$disk" ]]; then
    if [[ "$disk_mode" == "partial" ]]; then
      disk_v="$disk ($(human_size "$disk_bytes")) — ${partial_size} MiB, bölümler korunur"
      warn="Mevcut bölümler korunacak; yalnızca seçilen boş alana kurulum yapılacak."
    elif [[ "$disk_mode" == "existing" ]]; then
      disk_v="$disk — $existing_part FORMATLANACAK, diğer bölümler korunur"
      warn="UYARI: $existing_part üzerindeki TÜM VERİLER SİLİNECEK.\nEFI/boot: ${existing_esp:-yok}"
    else
      disk_v="$disk ($(human_size "$disk_bytes")) — TÜM DİSK SİLİNECEK"
      warn="UYARI: $disk üzerindeki TÜM VERİLER SİLİNECEK. Bu işlem geri alınamaz."
    fi
  else
    disk_v="seçilmedi"
    warn="UYARI: Kurulum hedefi seçilmedi."
  fi

  if [[ -n "$root_hash" ]]; then root_v="parolalı"; else root_v="kilitli"; fi
  user_v="${username:-oluşturulmadı}"
  [[ -n "$username" ]] && (( user_admin )) && user_v+=" (sudo)"

  text="KURULUM ÖZETİ\n\n"
  text+="Ağ       : $net_state · $hostname_v\n"
  text+="Bölge    : $kb · $timezone · $lang ($lang_src)\n"
  text+="Yazılım  : $(profile_short "$profile") / $(desktop_label) · limon (temel)\n"
  text+="Disk     : $disk_v\n"
  text+="Hesap    : root $root_v · $user_v\n"
  text+="Takas    : $(swap_label)\n"
  text+="Sürücüler: $driver_note\n\n"
  text+="$warn\n\n"
  text+="Onaylarsan kurulum başlar."

  confirm "$text" 24 78
}

# ------------------------------------------------------------------ akış
tui_main() {
  if [[ $EUID -ne 0 ]]; then
    echo "Kurulum aracı root olarak çalıştırılmalı." >&2
    exit 1
  fi
  check_ui
  if [[ -z "$DRYRUN" ]] && ! command -v archinstall >/dev/null; then
    info "archinstall bulunamadı. ISO görüntüsü eksik olabilir."; exit 1
  fi

  profile="$(find "$PROFILE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name common -printf '%f\n' 2>/dev/null | sort | head -n1)"
  [[ -n "$profile" ]] || { info "Profil dizini bulunamadı: $PROFILE_DIR"; exit 1; }

  trap cleanup EXIT
  swap_mib="$(swap_size_for_ram)"
  detect_drivers
  extras=""                  # limon her kurulumda temel; provider isteğe bağlı

  step_network
  step_locale
  step_software
  step_accounts
  step_disk
  step_swap
  if ! step_final; then
    echo "Vazgeçildi." >&2
    exit 130
  fi
  begin_install              # son onay alındı; arka uç kurulumu başlatır
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  tui_main "$@"
fi
