    commands.append(write_text("/etc/dconf/db/gdm.d/02-logo",
                               "[org/gnome/login-screen]\n"
                               "logo='/usr/share/pixmaps/horos-logo.png'\n") + "; true")
    if os.path.isfile(wall_src):
        # GDM arka planını da HorOS duvar kağıdına çek (gri varsayılanı kaldır).
        commands.append(write_text("/etc/dconf/db/gdm.d/03-wallpaper",
                                   "[org.gnome.desktop.background]\n"
                                   f"picture-uri='file://{wall_dest}'\n"
                                   f"picture-uri-dark='file://{wall_dest}'\n") + "; true")
    add_post("arch-chroot \"$HOROS_ROOT\" dconf update >/dev/null 2>&1 || true")
    add_post("arch-chroot \"$HOROS_ROOT\" gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true")
# /usr/share/backgrounds/horos icindeki tum gorselleri once hedef sisteme kopyalar,
# sonra GNOME ve KDE'nin "Arka plan" secenek listelerine kaydeder. Kanonik dosyalar
# olmadan XML'deki yollar bos onizlemeye yol acardi.
if wallpapers:
    def xml_escape(value):
        return (value.replace("&", "&amp;").replace("<", "&lt;")
                     .replace(">", "&gt;").replace('"', "&quot;"))

    def wp_label(path):
        label = os.path.splitext(os.path.basename(path))[0]
        label = label.replace("-", " ").replace("_", " ").title()
        label = label.replace("Horos", "HorOS", 1)
        if not label.lower().startswith("horos"):
            label = "HorOS " + label
        return label

    def wp_slug(value):
        slug = "".join(c if c.isalnum() else "-" for c in value).strip("-").lower()
        return slug or "horos"

    # Her gorseli bir kez /usr/share/backgrounds/horos/ altına yaz. KDE paketleri
    # ve GNOME listesi bu dosyalari gosterecek; ek kopya olmasin diye sembolik bag kullanilir.
    for path in wallpapers:
        name = os.path.basename(path)
        commands.append(write_cmd(path, os.path.join(wall_dir, name), "644"))

    gnome_xml = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">',
        '<wallpapers>',
    ]
    for path in wallpapers:
        gnome_xml += [
            '  <wallpaper deleted="false">',
            f'    <name>{xml_escape(wp_label(path))}</name>',
            f'    <filename>{path}</filename>',
            '    <options>zoom</options>',
            '    <shade_type>solid</shade_type>',
            '    <pcolor>#000000</pcolor>',
            '    <scolor>#000000</scolor>',
            '  </wallpaper>',
        ]
    gnome_xml += ['</wallpapers>', '']
    commands.append(
        "mkdir -p /usr/share/gnome-background-properties && "
        + write_text("/usr/share/gnome-background-properties/horos.xml", "\n".join(gnome_xml))
        + " || true"
    )

    for path in wallpapers:
        name = os.path.basename(path)
        stem = os.path.splitext(name)[0]
        ext = os.path.splitext(name)[1].lower()
        if stem == "horos-wallpaper":
            pkg = "horos"
        elif stem.startswith("horos"):
            pkg = wp_slug(stem)
        else:
            pkg = "horos-" + wp_slug(stem)
        image_dir = f"/usr/share/wallpapers/{pkg}/contents/images"
        canonical = os.path.join(wall_dir, name)
        image_file = f"{image_dir}/{name}"
        alias_file = f"{image_dir}/1920x1080{ext}"
        shot_file = f"/usr/share/wallpapers/{pkg}/contents/screenshot{ext}"
        meta = {
            "KPackageStructure": "Plasma/Wallpaper",
            "KPlugin": {
                "Id": pkg,
                "Name": wp_label(path),
                "Description": "HorOS Linux wallpaper",
                "License": "CC-BY-SA-4.0",
                "Authors": [{"Name": "HorOS Project"}],
            },
            "ServiceTypes": ["Plasma/Wallpaper"],
            "X-KDE-PlasmaImageWallpaper-AccentColor": "#FCC41D",
        }
        commands.append(" && ".join([
            f"mkdir -p {shlex.quote(image_dir)}",
            f"ln -sfn {shlex.quote(canonical)} {shlex.quote(image_file)}",
            f"ln -sfn {shlex.quote(canonical)} {shlex.quote(alias_file)}",
            f"ln -sfn {shlex.quote(canonical)} {shlex.quote(shot_file)}",
            write_text(f"/usr/share/wallpapers/{pkg}/metadata.json",
                       json.dumps(meta, indent=4, ensure_ascii=False) + "\n"),
        ]) + " || true")

if os.path.isfile(wall_src):
    # GNOME: sistem geneli varsayılan arka plan (kullanıcı özel ayarı yoksa geçerli).
    commands.append(
        "mkdir -p /usr/share/glib-2.0/schemas && "
        + write_text("/usr/share/glib-2.0/schemas/90_horos_wallpaper.gschema.override",
                     "[org.gnome.desktop.background]\n"
                     f"picture-uri='file://{wall_dest}'\n"
                     f"picture-uri-dark='file://{wall_dest}'\n"
                     "picture-options='zoom'\n")
        + " || true"
    )
    # Schema dosyasi staging uzerinden kurulumdan sonra kopyalanir; derlemeyi
    # post-actions icinde yapmak zorundayiz (eski chroot komutu dosya henuz
    # yokken calisir, eksik gschemas.compiled uretirdi).
    add_post("arch-chroot \"$HOROS_ROOT\" glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true")
    # KDE Plasma: plasma-org.kde.plasma.desktop-appletsrc dosyasini URETMIYORUZ.
    # Bu dosya hem masaustu hem panel containments'larini icerir; sadece duvar
    # kagidi icin kisitli bir dosya yazarsak Plasma paneli (ust/cubuk) hic olusturmaz.
    # Duvar kagitlari /usr/share/wallpapers altina kuruluyor; kullanici secim listesinde
    # gorunur. Varsayilan KDE duvar kagidini zorla ayarlamak icin ilk giriste
    # plasma-apply-wallpaperimage kullanilabilir; ama panel konfigini bozmamakoncecilik.

# Kali tarzi gecmis onerileri (zsh-autosuggestions) icin zsh yapilandirmasi.
# Yeni kullanicilar /etc/skel uzerinden, mevcut root ve kullanici ev dizinleri
# dogrudan ayni dosyayi alir; staging kurulumdan sonra kopyalanir.
zshrc_src = "/usr/share/horos/dotfiles/zshrc"
if os.path.isfile(zshrc_src):
    commands.append(write_cmd(zshrc_src, "/etc/skel/.zshrc", "644"))
    commands.append(write_cmd(zshrc_src, "/root/.zshrc", "644"))
    if username:
        commands.append(write_cmd(zshrc_src, f"/home/{username}/.zshrc", "644"))

# Kurulan sistem de live ISO ile ayni HorOS acilis ekranini kullanir.
# archinstall hedefe yalnizca paketlerin varsayilan "bgrt" temasini birakir;
# o tema firmware (gri) arka planini ve Arch spinner'ini gosterir.
plymouth_src = "/usr/share/plymouth/themes/horos"
if os.path.isdir(plymouth_src):
    for name in sorted(os.listdir(plymouth_src)):
        src = os.path.join(plymouth_src, name)
        if os.path.isfile(src):
            commands.append(
                write_cmd(src, os.path.join("/usr/share/plymouth/themes/horos", name), "644")
            )
    commands.append(
        write_text("/etc/plymouth/plymouthd.conf",
                   "[Daemon]\nTheme=horos\nShowDelay=0\n") + "; true"
    )
    # mkinitcpio: plymouth hook'u udev'den sonra, kms'ten once gelmeli.
    commands.append(
        "if [ -f /etc/mkinitcpio.conf ]; then "
        "grep -qE 'HOOKS=\\([^)]*\\bplymouth\\b' /etc/mkinitcpio.conf "
        "|| sed -i -E 's/(HOOKS=\\([^)]*\\budev\\b)/\\1 plymouth/' /etc/mkinitcpio.conf; "
        "fi; true"
    )
    add_post("arch-chroot \"$HOROS_ROOT\" mkinitcpio -P >/dev/null 2>&1 || true")

# AI-native varsayılan: limon tabanı her kuruluma gelir; extras yalnızca provider SDK'ları ekler.
# install.sh kaynak ağacın içinde çalışır (pip install -e .), bu yüzden depoyu klonlayıp içinden çalıştırırız.
# Betik HOME'a göre kurulum yapar: ~/.limon/.venv ve ~/.local/bin/limon. Bu yüzden root
# İÇİN DE, kurulum sırasında oluşturulan normal kullanıcı İÇİN DE ayrıca çalıştırılmalı.
packages += ["python", "python-pip", "git"]
# install.sh'in varsayılanı "all" olduğu için temel kurulumda bile --extras'ı açıkça geçir.
# extras boşsa "--extras=" (boş değer) temel bağımlılıkları kurar; değerler sabit listeden gelir.
extra_arg = " --extras=" + extras
repo_q = shlex.quote(repo)


def limon_install(home, label, owner=""):
    """limon'u verilen ev dizinine kurar; owner verilirse dosyalar o kullanıcıya geçer."""
    d = shlex.quote(home + "/.limon")
    h = shlex.quote(home)
    cmd = (f"git clone --depth 1 {repo_q} {d} "
           f"&& (cd {d} && HOME={h} SHELL=/bin/bash bash install.sh{extra_arg})")
    if owner:
        o = shlex.quote(owner)
        # chroot root olarak çalışır: klon, venv ve ~/.local kullanıcının olmalı.
        cmd += (f" && (chown -R {o}:{o} {d} {h}/.local; "
                f"chown -f {o}:{o} {h}/.bashrc {h}/.bash_profile {h}/.profile || true)")
    return (cmd + f" || echo 'HorOS: UYARI: limon {label} icin kurulamadi. "
            f"Sonra: git clone {repo} ~/.limon && cd ~/.limon && bash install.sh{extra_arg}'; true")


commands.append(limon_install("/root", "root"))
if username:
    # Normal kullanıcı girişinde `limon` komutunun bulunması için asıl kurulum bu.
    commands.append(limon_install(f"/home/{username}", username, username))

# Disk düzeni: UEFI için ESP + ext4 kök; BIOS için FAT32 /boot (boot bayraklı) + ext4 kök.
# "full" modu diski tamamen siler. "partial" modu mevcut bölümleri korur ve yalnızca
# seçilen boş alanda yeni bölümler oluşturur (çift sistem / veri korunur).
sec = int(E["H_SEC"])
total_mib = int(E["H_BYTES"]) // (1024 * 1024)

def size_of(mib):
    return {"sector_size": {"unit": "B", "value": sec}, "unit": "MiB", "value": mib}


def part(start, size, fs, flags, mount, status="create", dev=None):
    return {
        "btrfs": [], "dev_path": dev, "flags": flags, "fs_type": fs, "mount_options": [],
        "mountpoint": mount, "obj_id": str(uuid.uuid4()), "size": size_of(size),
        "start": size_of(start), "status": status, "type": "primary",
    }


if mode == "partial" and part_size >= 8192 and part_start >= 1:
    parts = []
    boot_flags = ["boot", "esp"] if efi else ["boot"]
    if esp_dev:
        # Var olan EFI/boot bölümü formatlanmadan bağlanır; Windows boot dosyaları korunur.
        parts.append(part(esp_start, esp_size, esp_fs, boot_flags, "/boot", "existing", esp_dev))
        root_start, root_size = part_start, part_size
    else:
        boot_size = 512 if efi else 1024
        parts.append(part(part_start, boot_size, "fat32", boot_flags, "/boot"))
        root_start, root_size = part_start + boot_size, part_size - boot_size - 1
    parts.append(part(root_start, root_size, "ext4", [], "/"))
    wipe = False
elif efi:
    parts = [part(1, 512, "fat32", ["boot", "esp"], "/boot"),
             part(513, total_mib - 513 - 1, "ext4", [], "/")]
    wipe = True
else:
    parts = [part(1, 1024, "fat32", ["boot"], "/boot"),
             part(1025, total_mib - 1025 - 1, "ext4", [], "/")]
    wipe = True

# Kurulum sonrasi koku ayirt etmek icin hedef sistemde bir isaret birakiriz.
# apply_branding ve verify_boot yalnizca bu dosyayi tasiyan bolumu kullanir.
# DIKKAT: write_text() staging'e yazar, staging ise kok bolum bulunduktan SONRA
# kopyalanir. Bu yuzden isaret custom_command ile dogrudan hedefe yazilmalidir.
commands.append(
    "printf '%s\\n' " + shlex.quote(disk_dev) + " > /etc/horos-install-target; true"
)

# Sadece dosya yazan yer tutucu komutlar (":") logda goremeyelim.
commands = [c for c in commands if c.strip() != ":"]

config = {
    # Eski şema ("bootloader") ve yeni şema ("bootloader_config"): archinstall bilmediğini yok sayar.
    "bootloader": "Grub",
    "bootloader_config": {"bootloader": "Grub", "uki": False, "removable": removable_efi},
    "hostname": E["H_HOST"],
    "packages": list(dict.fromkeys(packages)),
    "custom_commands": commands,
    "timezone": E["H_TZ"] or "UTC",
    "locale_config": {"kb_layout": E["H_KB"], "sys_lang": lang, "sys_enc": enc},
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": [{"device": E["H_DISK"], "partitions": parts, "wipe": wipe}],
    },
}
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(config, f, indent=2, ensure_ascii=False)

# Rastgele staging yollari bash'a config'in yanisindaki kucuk meta dosyasiyla aktarilir.
fd = os.open(out + ".branding", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump({"staging": STAGE, "post": POST}, f)

# Dosya kopyalandiktan sonra chroot icinde calistirilacak kucuk islemler.
with open(POST, "w", encoding="utf-8") as f:
    f.write("#!/bin/bash\nset -u\n" + "\n".join(post_actions) + "\n")
os.chmod(POST, 0o755)
PY
}

# Marka dosyalarini archinstall config'ine base64 olarak gommek yerine live
# sistemde hazirladik; kurulum bitince kok bolumu yazilabilir baglayip cp -a ile
# hedef sisteme kopyalariz. Boylece kurulum logunda base64 yigitlari akmz.
apply_branding() {
  local staging="${BRAND_STAGE:-}" post="${BRAND_POST:-}"
  local m p root="" rc=0 attempt ids=""
  local parts=()
  [[ -n "$staging" && -d "$staging" ]] || { rm -f "$post"; return 0; }

  echo
  echo "HorOS marka dosyalari yerlestiriliyor..."
  udevadm settle 2>/dev/null || true
  release_target || true

  mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part"{print $1}')
  m="$(mktemp -d /tmp/horos-brand.XXXXXX)"
  MOUNT_DIRS+=("$m")
  for p in "${parts[@]}"; do
    mount -o ro "$p" "$m" 2>/dev/null || continue
    # Cift sistemde baska Linux kurulu olabilir; yalnizca kendi isaretimizi tasiyan
    # bolum hedefimizdir (ilk eslesme degil, kesin eslesme).
    if [[ -f "$m/etc/fstab" && -d "$m/usr" && -f "$m/etc/horos-install-target" ]]; then
      root="$p"
    fi
    umount "$m" 2>/dev/null || true
    [[ -n "$root" ]] && break
  done
  if [[ -z "$root" ]]; then
    echo "${R}UYARI:${N} kok bolum bulunamadi, marka dosyalari kopyalanamadi."
    rmdir "$m" 2>/dev/null || true
    forget_mount "$m"
    rm -rf "$staging" "$post"
    BRAND_STAGE=""; BRAND_POST=""
    return 1
  fi

  for attempt in 1 2 3; do
    umount -R "$m" 2>/dev/null || true
    if mount -o rw "$root" "$m" 2>/dev/null; then rc=0; break; fi
    rc=1; sleep 1
  done
  if (( rc != 0 )); then
    echo "${R}UYARI:${N} kok bolum ($root) yazilabilir baglanamadi."
    rmdir "$m" 2>/dev/null || true
    forget_mount "$m"
    rm -rf "$staging" "$post"
    BRAND_STAGE=""; BRAND_POST=""
    return 1
  fi

  cp -a "$staging/." "$m/" || rc=1

  # staging dosyalari cp -a ile root:root gelir. GNOME dconf ve KDE ayarlari
  # kullanici yazamazsa reboot'ta varsayilana doner; ev dizinini burada, dis
  # chroot'a gerek kalmadan ve sonucunu kontrol ederek duzeltiyoruz.
  if [[ -n "${username:-}" && -d "$m/home/$username" ]]; then
    # Live ISO /etc/passwd'inde hedef kullanici yok; "chown nar:nar" invalid user
    # olur. Hedefin passwd dosyasindan sayisal UID/GID alip onu kullaniyoruz.
    ids="$(awk -F: -v u="$username" '$1==u {print $3 ":" $4; exit}' "$m/etc/passwd" 2>/dev/null)"
    if [[ -n "$ids" ]]; then
      if ! chown -R "$ids" "$m/home/$username" 2>/dev/null; then
        echo "${R}UYARI:${N} $username ev dizininin sahipligi duzeltilemedi; masaustu ayarlari kaybolabilir."
        rc=1
      fi
    else
      echo "${R}UYARI:${N} $username hedef passwd'de bulunamadi; ev dizini sahipligi duzeltilemedi."
      rc=1
    fi
  fi

  if [[ -f "$post" ]]; then
    HOROS_ROOT="$m" bash "$post" || true
  fi
  umount "$m" 2>/dev/null || rc=1
  rmdir "$m" 2>/dev/null || true
  forget_mount "$m"
  rm -rf "$staging" "$post"
  BRAND_STAGE=""; BRAND_POST=""
  (( rc == 0 )) && echo "${G}Marka dosyalari kuruldu.${N}"
  return "$rc"
}

# Kurulum bitince diski salt-okunur bağlayıp çekirdek, initramfs ve önyükleyici dosyalarını arar.
verify_boot() {
  local m mount_err rc attempt efi=0 parts=() boot root problems=()
  is_efi && efi=1

  # archinstall'in chroot'unda açılan swapfile live ortamda hâlâ aktif kalabilir.
  # Swap'i önce kapatıp /mnt'i güvenle boşaltıyoruz (ayrıntı: release_target).
  udevadm settle 2>/dev/null || true
  release_target || true

  mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part"{print $1}')
  if (( ${#parts[@]} < 2 )); then
    echo "${R}UYARI:${N} $disk üzerinde beklenen bölümler bulunamadı."; return 1
  fi
  m="$(mktemp -d /tmp/horos-verify.XXXXXX)"
  MOUNT_DIRS+=("$m")
  mount_err="$(mktemp /tmp/horos-verify-mount.XXXXXX)"

  if [[ "$disk_mode" == "partial" ]]; then
    # Kısmi kurulumda bölüm sırası değişir; kökü ve boot'u içeriğinden bul.
    local p candidate=""
    for p in "${parts[@]}"; do
      mount -o ro "$p" "$m" 2>/dev/null || continue
      if [[ -d "$m/EFI" || -f "$m/grub/grub.cfg" ]]; then candidate="$p"; fi
      umount "$m" 2>/dev/null || true
      [[ -n "$candidate" ]] && break
    done
    boot="$candidate"
    root=""
    for p in "${parts[@]}"; do
      mount -o ro "$p" "$m" 2>/dev/null || continue
      # marka dosyalarini kopyaladigimiz kok bolum; baska Linux'a ait olabilir.
      if [[ -f "$m/etc/fstab" && -d "$m/usr" && -f "$m/etc/horos-install-target" ]]; then
        root="$p"
      fi
      umount "$m" 2>/dev/null || true
      [[ -n "$root" ]] && break
    done
    if [[ -z "$root" ]]; then
      echo "${R}UYARI:${N} HorOS kok bolumu bulunamadi; önyükleme doğrulanamadi."
      rm -f "$mount_err"; rmdir "$m" 2>/dev/null || true
      forget_mount "$m"
      return 1
    fi
    [[ -z "$boot" ]] && boot="$root"
  else
    # Tam disk modunda ilk bölüm /boot, son bölüm kök.
    boot="${parts[0]}"; root="${parts[-1]}"
  fi

  # Bölüm tablosu/udev birkaç saniye gecikebiliyor; kısa bir retry yeterli.
  rc=1
  for attempt in 1 2 3; do
    swapoff -a 2>/dev/null || true
    umount -R "$m" 2>/dev/null || true
    if mount -o ro "$root" "$m" 2>"$mount_err"; then rc=0; break; fi
    sleep 1
  done
  if (( rc != 0 )); then
    echo "${R}UYARI:${N} kök bölüm ($root) bağlanamadı: $(tr '\n' ' ' < "$mount_err")"
    rm -f "$mount_err"; rmdir "$m" 2>/dev/null || true
    forget_mount "$m"
    return 1
  fi

  [[ -d "$m/boot" ]] || mkdir -p "$m/boot" 2>/dev/null || problems+=("boot dizini oluşturulamadı")
  mount -o ro "$boot" "$m/boot" 2>/dev/null || problems+=("boot bölümü ($boot) bağlanamadı")
  compgen -G "$m/boot/vmlinuz-*" >/dev/null || problems+=("çekirdek yok (/boot/vmlinuz-*)")
  compgen -G "$m/boot/initramfs-*.img" >/dev/null || problems+=("initramfs yok (/boot/initramfs-*.img)")
  [[ -f "$m/boot/grub/grub.cfg" || -f "$m/boot/loader/loader.conf" ]] \
    || problems+=("önyükleyici yapılandırması yok (grub.cfg)")
  if (( efi )); then
    find "$m/boot/EFI" -iname '*.efi' 2>/dev/null | grep -q . || problems+=("EFI önyükleyici dosyası yok")
  else
    [[ -f "$m/boot/grub/i386-pc/core.img" ]] || problems+=("GRUB (BIOS) core.img yok")
  fi

  umount -R "$m" 2>/dev/null || true
  swapoff -a 2>/dev/null || true
  rm -f "$mount_err"
  rmdir "$m" 2>/dev/null || true
  forget_mount "$m"

  if (( ${#problems[@]} > 0 )); then
    echo "${R}Önyükleme doğrulaması başarısız:${N}"
    printf '  - %s\n' "${problems[@]}"
    echo "Kayıt: /var/log/archinstall/install.log"
    return 1
  fi
  echo "${G}Önyükleme doğrulandı:${N} çekirdek, initramfs ve önyükleyici yerinde."
  return 0
}

begin_install() { # TUI son onayı zaten aldı; burada INSTALL onayı sorulmaz.
  local missing=()
  [[ -z "$disk" ]] && missing+=("Kurulum hedefi")
  admin_ok || missing+=("Yönetici hesap (kullanıcı oluştur veya root parolası belirle)")
  if [[ -z "$DRYRUN" ]]; then
    echo "Ağ denetleniyor..."
    if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; missing+=("İnternet bağlantısı (Ağ adımından bağlantıyı kur)"); fi
  fi
  if (( ${#missing[@]} > 0 )); then
    echo
    echo "${R}Önce tamamlanması gerekenler:${N}"
    printf '  - %s\n' "${missing[@]}"
    pause 3
    return 99
  fi

  echo
  echo "${Y}Kurulacak sistem${N}"
  echo "  Profil      : $(profile_title "$profile")"
  echo "  Masaüstü    : $(desktop_label)"
  if [[ "$disk_mode" == "partial" ]]; then
    echo "  Disk        : $disk ($(human_size "$disk_bytes")) — ${G}${partial_size} MiB alan, mevcut bölümler korunur${N}"
  else
    echo "  Disk        : $disk ($(human_size "$disk_bytes")) — ${R}TÜM VERİLER SİLİNECEK${N}"
  fi
  echo "  Takas       : $(swap_label)"
  echo "  Sürücüler   : $driver_note"
  echo "  Önyükleme   : $(is_efi && echo UEFI || echo BIOS)"
  echo "  Makine adı  : $hostname_v   Saat dilimi: $timezone   Klavye: $kb   Dil: $lang.UTF-8"
  echo "  Kullanıcı   : ${username:-yok}$( ((user_admin)) && [[ -n "$username" ]] && echo ' (sudo)')   Root: $([[ -n "$root_hash" ]] && echo parolalı || echo kilitli)"
  echo "  limon       : $(limon_label)"
  echo
  local cfg paths
  cfg="$(mktemp --suffix=.json /tmp/horos-archinstall.XXXXXX)"
  CFG="$cfg"; BRAND_META="$cfg.branding"; BRAND_STAGE=""; BRAND_POST=""
  if ! generate_config "$cfg"; then
    echo "HATA: yapılandırma üretilemedi." >&2
    rm -f "$cfg" "$BRAND_META"; CFG=""; BRAND_META=""
    return 1
  fi
  # Python rastgele staging yollari uretir; onlari config'in yanisindaki
  # kucuk meta dosyasindan oku (archinstall bilinmeyen config anahtarini reddedebilir).
  if [[ -f "$BRAND_META" ]]; then
    paths="$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d["staging"],d["post"])' "$BRAND_META" 2>/dev/null)" || paths=""
    [[ -n "$paths" ]] && read -r BRAND_STAGE BRAND_POST <<<"$paths"
  fi

  if [[ -n "$DRYRUN" ]]; then
    echo "DRYRUN: yapılandırma yazıldı, kurulum yapılmadı: $cfg"
    rm -f "$BRAND_META"
    CFG=""; BRAND_META=""
    return 0
  fi

  echo
  prepare_pacman || {
    rm -f "$cfg" "$BRAND_META"; CFG=""; BRAND_META=""
    rm -rf "$BRAND_STAGE"; rm -f "$BRAND_POST"
    BRAND_STAGE=""; BRAND_POST=""
    return 1
  }
  if ! release_target; then
    echo "${R}HATA:${N} /mnt kapatılamadı; archinstall hedefi kullanamaz." >&2
    findmnt -R /mnt 2>/dev/null || true
    rm -rf "$BRAND_STAGE"; rm -f "$BRAND_POST" "$BRAND_META" "$CFG"
    BRAND_STAGE=""; BRAND_POST=""; BRAND_META=""; CFG=""
    return 1
  fi

  echo
  echo "Kurulum başlıyor..."
  local rc=0 brand_rc=0 boot_rc=0
  archinstall --config "$cfg" --silent || rc=$?
  rm -f "$cfg" "$BRAND_META"; CFG=""; BRAND_META=""
  if (( rc == 0 )); then
    apply_branding || brand_rc=$?
    echo
    verify_boot || boot_rc=$?
  fi
  # Marka hatası önyükleme doğrulamasını gizlemesin; önyükleme öncelikli.
  (( boot_rc )) && return 3
  (( brand_rc )) && return 4
  return "$rc"
}

