#!/usr/bin/env bash
# HorOS Linux — diske kurulum (archinstall tabanlı)
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Kurulum aracı root olarak çalıştırılmalı."
  exit 1
fi

if ! command -v archinstall >/dev/null; then
  echo "archinstall bulunamadı." >&2
  exit 1
fi

cat <<'INFO'
HorOS Linux Installer

Bu araç archinstall'ın etkileşimli kurulum arayüzünü açar.
İnternet bağlantısı gerekir (kablolu bağlantı otomatik kurulur;
Wi-Fi için: nmtui).
Disk bölümleme sırasında seçtiğin hedef diskteki veriler silinebilir.
Devam etmeden önce yedek al.
INFO

if ! ping -c1 -W3 archlinux.org &>/dev/null; then
  echo
  echo "UYARI: İnternet bağlantısı görünmüyor. Kurulum için önce 'nmtui' ile bağlan."
fi

echo
read -rp "archinstall'ı başlatmak için INSTALL yaz: " answer
if [[ "$answer" != "INSTALL" ]]; then
  echo "İptal edildi."
  exit 0
fi

exec archinstall
