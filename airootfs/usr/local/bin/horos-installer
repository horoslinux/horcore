#!/usr/bin/env bash
# HorOS Linux — kurulum arayüzü
# Fedora (Anaconda) tarzı "Kurulum Özeti" ekranı; arka uçta archinstall --silent çalışır.
# Test için: HOROS_DRYRUN=1 horos-installer  (yapılandırmayı yazar, diske dokunmaz)
set -uo pipefail
export LC_ALL=C.UTF-8   # ${#var} karakter saysın (Türkçe harflerle hizalama)

LIMON_URL="https://horoslinux.github.io/limon/install.sh"
PROFILE_DIR="${HOROS_PROFILE_DIR:-/usr/share/horos/profiles}"
KEYMAP_DIR="${KEYMAP_DIR:-/usr/share/kbd/keymaps}"
DRYRUN="${HOROS_DRYRUN:-}"

Y=$'\e[1;33m'; R=$'\e[1;31m'; G=$'\e[1;32m'; D=$'\e[2m'; N=$'\e[0m'

# ---- Durum (özet ekranındaki her satır bir değişken) ----
kb=us; timezone=UTC; tz_src="varsayılan"; country=""
profile=""; extras=""; desktop=""
disk=""; disk_bytes=0; disk_sec=512
hostname_v="horos"; net_state="denetleniyor..."
root_hash=""; username=""; user_hash=""; user_admin=1
PW_HASH=""
kb_ok=0; detect_done=0; DETECT_DIR=""

# ---------------------------------------------------------------- yardımcılar
# ICMP engellenmiş ağlarda yanlış "bağlantı yok" dememek için ping + HTTPS denetimi.
have_net() {
  ping -c1 -W2 archlinux.org &>/dev/null && return 0
  curl -fsS --max-time 4 -o /dev/null https://archlinux.org/ &>/dev/null
}

ip_lookup() { # $1: alan (timezone | country)
  local url val
  for url in "https://ipapi.co/$1" "https://ipinfo.io/$1"; do
    val="$(curl -fsS --max-time 4 "$url" 2>/dev/null | tr -d '[:space:]')" || continue
    if [[ "$val" =~ ^[A-Za-z0-9_+/-]+$ ]]; then echo "$val"; return 0; fi
  done
  return 1
}

keymap_for_country() {
  case "$1" in
    TR) echo trq ;;       US) echo us ;;         GB) echo uk ;;
    DE|AT) echo de-latin1 ;;  FR) echo fr ;;     ES) echo es ;;
    IT) echo it ;;        PT) echo pt-latin1 ;;  BR) echo br-abnt2 ;;
    NL) echo nl ;;        BE) echo be-latin1 ;;  CH) echo sg-latin1 ;;
    SE) echo sv-latin1 ;; NO) echo no ;;         DK) echo dk ;;
    FI) echo fi ;;        PL) echo pl ;;         CZ) echo cz-lat2 ;;
    RU) echo ru ;;        UA) echo ua ;;         GR) echo gr ;;
    HU) echo hu ;;        RO) echo ro ;;         IE) echo ie ;;
    JP) echo jp106 ;;
    *) echo us ;;
  esac
}

keymap_exists() {
  [[ -d "$KEYMAP_DIR" ]] || return 0   # doğrulanamıyorsa engelleme
  find "$KEYMAP_DIR" -type f \( -name "$1.map" -o -name "$1.map.gz" \) 2>/dev/null | grep -q .
}

profile_title() {
  local f="$PROFILE_DIR/$1/title"
  if [[ -f "$f" ]]; then head -n1 "$f"; else echo "$1"; fi
}

profile_short() { profile_title "$1" | sed 's/ —.*//'; }

limon_label() {
  case "$extras" in
    "") echo "Kurulmayacak" ;;
    all) echo "Kurulacak (Claude, OpenAI, Gemini)" ;;
    *) echo "Kurulacak ($extras)" ;;
  esac
}

desktop_label() {
  if [[ "$profile" != workstation ]]; then
    echo "— (yalnızca Workstation)"
    return
  fi
  case "$desktop" in
    kde) echo "KDE Plasma" ;;
    gnome) echo "GNOME" ;;
    *) echo "Kurulmayacak" ;;
  esac
}

pause() { sleep "${1:-1}"; }

# Ağ + konum tespiti arka planda çalışır; ekran beklemeden açılır, sonuç gelince özet güncellenir.
start_detect() {
  DETECT_DIR="$(mktemp -d /tmp/horos-detect.XXXXXX)"
  (
    n=0; tz=""; c=""
    for _ in 1 2 3 4 5 6; do
      if have_net; then n=1; break; fi
      sleep 1
    done
    if (( n )); then
      tz="$(ip_lookup timezone || true)"
      c="$(ip_lookup country || true)"
    fi
    printf 'net=%s\ntz=%s\ncountry=%s\n' "$n" "$tz" "$c" > "$DETECT_DIR/tmp" \
      && mv "$DETECT_DIR/tmp" "$DETECT_DIR/done"
  ) >/dev/null 2>&1 &
}

# Sonuç geldiyse uygular; ekranın yenilenmesi gerekiyorsa 0 döner.
apply_detect() {
  (( detect_done )) && return 1
  [[ -f "$DETECT_DIR/done" ]] || return 1
  local k v n="" t="" c="" kb2
  while IFS='=' read -r k v; do
    case "$k" in net) n="$v" ;; tz) t="$v" ;; country) c="$v" ;; esac
  done < "$DETECT_DIR/done"
  detect_done=1
  if [[ "$n" == 1 ]]; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
  if [[ -n "$t" && "$tz_src" == "varsayılan" && -f "/usr/share/zoneinfo/$t" ]]; then
    timezone="$t"; tz_src="IP'den tespit edildi"
  fi
  if [[ "$c" =~ ^[A-Z]{2}$ ]]; then
    country="$c"
    if (( ! kb_ok )); then
      kb2="$(keymap_for_country "$c")"
      keymap_exists "$kb2" && kb="$kb2"
    fi
  fi
  rm -rf "$DETECT_DIR"
  return 0
}

# ---------------------------------------------------------------- bölümler
set_keyboard() {
  local in k
  echo
  echo "Parolanı bu düzenle yazacaksın; doğru düzeni seçtiğinden emin ol."
  while true; do
    read -rp "Klavye düzeni [$kb] (Enter = kabul; örn: us, trq, trf, uk, de-latin1): " in || in=""
    k="${in:-$kb}"
    if keymap_exists "$k"; then kb="$k"; break; fi
    echo "'$k' bulunamadı. Tüm düzenler için: localectl list-keymaps"
  done
  loadkeys "$kb" 2>/dev/null || true   # parola girişleri için hemen uygula
  kb_ok=1
}

set_timezone() {
  local in z
  echo
  echo "Örnek: Europe/Istanbul, America/New_York, UTC (arama için bir parça yaz: ist)"
  while true; do
    read -rp "Saat dilimi [$timezone]: " in || in=""
    z="${in:-$timezone}"
    if [[ "$z" =~ ^[A-Za-z0-9_+/-]+$ && -f "/usr/share/zoneinfo/$z" ]]; then
      timezone="$z"; tz_src="elle seçildi"; return 0
    fi
    echo "Bulunamadı. Eşleşenler:"
    timedatectl list-timezones 2>/dev/null | grep -i -- "${z//[^A-Za-z0-9_+\/-]/}" | head -n 10 | sed 's/^/  /'
  done
}

set_profile() {
  local profiles=() p i pc
  mapfile -t profiles < <(find "$PROFILE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name common -printf '%f\n' 2>/dev/null | sort)
  (( ${#profiles[@]} > 0 )) || { echo "Profil bulunamadı: $PROFILE_DIR"; pause 2; return 0; }
  echo
  i=0
  for p in "${profiles[@]}"; do
    i=$((i + 1)); printf '  %d) %s\n' "$i" "$(profile_title "$p")"
  done
  read -rp "Seçim [1-${#profiles[@]}]: " pc || return 0
  if [[ "$pc" =~ ^[0-9]+$ ]] && (( 10#$pc >= 1 && 10#$pc <= ${#profiles[@]} )); then
    profile="${profiles[10#$pc - 1]}"
    if [[ "$profile" == workstation ]]; then
      set_desktop
    else
      desktop=""
    fi
  else
    echo "Geçersiz seçim."; pause
  fi
}

set_desktop() {
  local a
  if [[ "$profile" != workstation ]]; then
    echo
    echo "Masaüstü ortamı yalnızca Workstation profilinde seçilir."
    pause 2; return 0
  fi
  echo
  echo "KDE Plasma veya GNOME kurulsun mu? (şu an: $(desktop_label))"
  echo "  1) Kurma — yalnızca terminal"
  echo "  2) KDE Plasma"
  echo "  3) GNOME"
  read -rp "Seçim [1-3]: " a || return 0
  case "$a" in
    1) desktop="" ;;
    2) desktop=kde ;;
    3) desktop=gnome ;;
    *) echo "Geçersiz seçim."; pause ;;
  esac
}

set_limon() {
  local a
  echo
  echo "AI asistanı (limon). Yalnızca seçtiğin sağlayıcının SDK'sı kurulur."
  echo "  1) Hayır"
  echo "  2) Evet — Claude"
  echo "  3) Evet — OpenAI"
  echo "  4) Evet — Gemini"
  echo "  5) Evet — hepsi"
  read -rp "Seçim [1-5]: " a || return 0
  case "$a" in
    1) extras="" ;;
    2) extras=claude ;;
    3) extras=openai ;;
    4) extras=gemini ;;
    5) extras=all ;;
    *) echo "Geçersiz seçim."; pause ;;
  esac
}

# Disk listesi: yol<TAB>bayt<TAB>model<TAB>sektör  (kurulum ortamının kendi diski hariç)
list_disks() {
  local src live=""
  src="$(findmnt -rno SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -n "$src" ]]; then
    live="$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)"
    [[ -n "$live" ]] && live="/dev/$live"
  fi
  LIVE_DEV="$live" python3 - <<'PY'
import json, os, subprocess
live = os.environ.get("LIVE_DEV", "")
raw = subprocess.run(
    ["lsblk", "-J", "-b", "-d", "-p", "-o", "NAME,SIZE,MODEL,TYPE,RO,LOG-SEC"],
    capture_output=True, text=True).stdout
for d in json.loads(raw or '{"blockdevices": []}')["blockdevices"]:
    name = d.get("name") or ""
    if d.get("type") != "disk" or name == live or name.startswith("/dev/zram"):
        continue
    if str(d.get("ro")).lower() in ("1", "true"):
        continue
    size = int(d.get("size") or 0)
    sec = int(d.get("log-sec") or 512)
    model = (d.get("model") or "disk").strip()
    print(f"{name}\t{size}\t{model}\t{sec}")
PY
}

human_size() { python3 -c "import sys;b=int(sys.argv[1]);print(f'{b/1e9:.0f} GB' if b<1e12 else f'{b/1e12:.1f} TB')" "$1"; }

set_disk() {
  local lines=() l i=0 pc name size model sec
  mapfile -t lines < <(list_disks)
  if (( ${#lines[@]} == 0 )); then
    echo; echo "Kurulabilecek disk bulunamadı."; pause 2; return 0
  fi
  echo
  echo "Kurulum hedefi — ${R}seçilen diskteki TÜM veriler silinir${N} (otomatik bölümleme)."
  for l in "${lines[@]}"; do
    i=$((i + 1))
    IFS=$'\t' read -r name size model sec <<<"$l"
    printf '  %d) %s  %s  %s\n' "$i" "$name" "$(human_size "$size")" "$model"
  done
  read -rp "Seçim [1-${#lines[@]}]: " pc || return 0
  if [[ "$pc" =~ ^[0-9]+$ ]] && (( 10#$pc >= 1 && 10#$pc <= ${#lines[@]} )); then
    IFS=$'\t' read -r name size model sec <<<"${lines[10#$pc - 1]}"
    if (( size < 8 * 1024 * 1024 * 1024 )); then
      echo "Disk çok küçük (en az 8 GB gerekir)."; pause 2; return 0
    fi
    disk="$name"; disk_bytes="$size"; disk_sec="$sec"
  else
    echo "Geçersiz seçim."; pause
  fi
}

set_network() {
  local in h
  echo
  if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
  echo "Ağ durumu: $net_state"
  read -rp "Ağ ayarlarını aç (nmtui, Wi-Fi için)? [e/H]: " in || in=""
  if [[ "${in,,}" == e* ]]; then
    nmtui || true
    if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
  fi
  while true; do
    read -rp "Ana makine adı [$hostname_v]: " in || in=""
    h="${in:-$hostname_v}"
    if [[ "$h" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then hostname_v="$h"; break; fi
    echo "Geçersiz ad (küçük harf, rakam ve '-' kullan)."
  done
}

# Parolayı iki kez sorar; yescrypt/sha512 özetini PW_HASH'e yazar. Boş giriş = vazgeç.
ask_password() { # $1: etiket
  local p1 p2
  (( kb_ok )) || set_keyboard   # yanlış düzen parolayı bozar: yazmadan önce onayla
  while true; do
    read -rsp "Parola ($1; en az 8 karakter, boş = vazgeç): " p1 || return 1; echo
    [[ -z "$p1" ]] && return 1
    if (( ${#p1} < 8 )); then echo "En az 8 karakter olmalı."; continue; fi
    read -rsp "Parolayı tekrar yaz: " p2 || return 1; echo
    [[ "$p1" == "$p2" ]] && break
    echo "Parolalar eşleşmiyor."
  done
  PW_HASH="$(printf '%s' "$p1" | openssl passwd -6 -stdin)" || return 1
  [[ "$PW_HASH" == '$6$'* ]]
}

set_root() {
  local a
  echo
  echo "Root hesabı:"
  echo "  1) Kilitli (önerilen) — yönetim için sudo'lu kullanıcı kullanılır"
  echo "  2) Root parolası belirle"
  read -rp "Seçim [1-2]: " a || return 0
  case "$a" in
    1) root_hash="" ;;
    2) if ask_password "root"; then root_hash="$PW_HASH"; else echo "Vazgeçildi."; pause; fi ;;
    *) echo "Geçersiz seçim."; pause ;;
  esac
}

set_user() {
  local u a
  echo
  read -rp "Kullanıcı adı [boş = vazgeç]: " u || return 0
  [[ -z "$u" ]] && return 0
  if [[ ! "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ || "$u" == root ]]; then
    echo "Geçersiz kullanıcı adı (küçük harf, rakam, '_' ve '-')."; pause 2; return 0
  fi
  ask_password "kullanıcı $u" || { echo "Vazgeçildi."; pause; return 0; }
  read -rp "Yönetici (sudo) olsun mu? [E/h]: " a || a=""
  username="$u"; user_hash="$PW_HASH"
  if [[ "${a,,}" == h* ]]; then user_admin=0; else user_admin=1; fi
}

# ---------------------------------------------------------------- özet ekranı
show_banner() {
  clear
  cat <<'BANNER'
 _   _            ___  ____
| | | | ___  _ __/ _ \/ ___|
| |_| |/ _ \| '__| | | \___ \
|  _  | (_) | |  | |_| |___) |
|_| |_|\___/|_|   \___/|____/
BANNER
  echo
}

row() { # $1 numara, $2 etiket, $3 değer, $4 uyarı (varsa)
  printf ' %s) %s%*s %s%s\n' "$1" "$2" $((26 - ${#2})) "" "$3" "${4:+  ${R}$4${N}}"
}

admin_ok() { [[ -n "$root_hash" ]] || { [[ -n "$username" ]] && (( user_admin == 1 )); }; }

show_hub() {
  local disk_v user_v root_v warn_d="" warn_u="" warn_n=""
  if [[ -n "$disk" ]]; then disk_v="$disk ($(human_size "$disk_bytes")) — otomatik bölümleme"
  else disk_v="seçilmedi"; warn_d="(!) tamamlanmalı"; fi
  if [[ -n "$username" ]]; then user_v="$username$( ((user_admin)) && echo ' (yönetici)' )"
  else user_v="oluşturulmadı"; fi
  admin_ok || warn_u="(!) yönetici hesap gerekli"
  [[ "$net_state" == "Bağlı değil" ]] && warn_n="(!) kurulum için ağ gerekli"
  if [[ -n "$root_hash" ]]; then root_v="Parola belirlendi"; else root_v="Kilitli"; fi

  show_banner
  echo "${Y}KURULUM ÖZETİ${N}"
  echo
  echo "${Y}YEREL AYARLAR${N}"
  row 1 "Klavye"               "$kb$( ((kb_ok)) || echo " ${D}(önerilen, onaylanmadı)${N}")"
  row 2 "Saat dilimi"          "$timezone ${D}($tz_src)${N}"
  echo "${Y}YAZILIM${N}"
  row 3 "Kurulum profili"      "$(profile_short "$profile")"
  row 4 "Masaüstü ortamı"      "$(desktop_label)"
  row 5 "AI asistanı (limon)"  "$(limon_label)"
  echo "${Y}SİSTEM${N}"
  row 6 "Kurulum hedefi"       "$disk_v" "$warn_d"
  row 7 "Ağ ve makine adı"     "$net_state · $hostname_v" "$warn_n"
  echo "${Y}KULLANICI AYARLARI${N}"
  row 8 "Root hesabı"          "$root_v"
  row 9 "Kullanıcı oluştur"    "$user_v" "$warn_u"
  echo
  echo " ${G}b${N}) Kurulumu başlat      ${D}q) Vazgeç${N}"
  echo
}

# ---------------------------------------------------------------- kurulum hazırlığı
wait_unit() { # $1 unit, $2 mesaj, $3 en fazla saniye
  local unit="$1" msg="$2" max="${3:-90}" i=0 st
  while (( i < max )); do
    st="$(systemctl is-active "$unit" 2>/dev/null || true)"
    case "$st" in activating|reloading) ;; *) return 0 ;; esac
    (( i == 0 )) && echo "$msg"
    sleep 1; i=$((i + 1))
  done
  echo "UYARI: $unit $max saniyede bitmedi, devam ediliyor." >&2
}

prepare_pacman() {
  wait_unit pacman-init.service "Pacman anahtar deposu hazırlanıyor..." 120
  wait_unit reflector.service   "Mirror listesi güncelleniyor..." 90

  if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" != yes ]]; then
    echo "Saat eşitleniyor..."
    timedatectl set-ntp true 2>/dev/null || true
    local i
    for i in $(seq 1 15); do
      [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" == yes ]] && break
      sleep 1
    done
  fi

  echo "Paket veritabanı eşitleniyor..."
  local out
  if out="$(pacman -Sy 2>&1)"; then return 0; fi

  echo "İlk deneme başarısız oldu:" >&2
  tail -n 6 <<<"$out" | sed 's/^/  /' >&2

  if grep -qiE 'signature|pgp|keyring|unknown trust|key ' <<<"$out"; then
    echo "Anahtar deposu yeniden hazırlanıyor..."
    pacman-key --init >/dev/null 2>&1 || true
    pacman-key --populate archlinux >/dev/null 2>&1 || true
  fi
  if grep -qiE 'failed retrieving|could not resolve|resolve host|404|timed out|timeout|no servers|failed to connect|connection' <<<"$out"; then
    echo "Mirror listesi sabit bir mirror'a çevriliyor..."
    printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist
  fi

  if out="$(pacman -Sy 2>&1)"; then return 0; fi
  echo >&2
  echo "HATA: Paket veritabanı eşitlenemedi. Kurulum bu yüzden başlayamaz." >&2
  tail -n 8 <<<"$out" | sed 's/^/  /' >&2
  echo >&2
  echo "Kontrol et: 'systemctl status pacman-init reflector', 'timedatectl', 'ping archlinux.org'" >&2
  return 1
}

# ---------------------------------------------------------------- archinstall yapılandırması
# Disk düzeni, saat dilimi, dil ve ana makine adı archinstall'a verilir; kullanıcı, parola, güvenlik
# duvarı ve servisler custom_commands ile kurulan sistemde yapılır (archinstall sürümleri arasında
# şeması en kararlı olan yol).
generate_config() { # $1: çıktı dosyası
  local efi=0 wifi=0
  [[ -d /sys/firmware/efi ]] && efi=1
  [[ -n "${HOROS_EFI:-}" ]] && efi="$HOROS_EFI"   # yalnızca test için
  compgen -G '/sys/class/net/*/wireless' >/dev/null && wifi=1

  H_PROFILE="$profile" H_PDIR="$PROFILE_DIR" H_EXTRAS="$extras" H_URL="$LIMON_URL" \
  H_DESKTOP="$desktop" \
  H_TZ="$timezone" H_KB="$kb" H_HOST="$hostname_v" H_DISK="$disk" H_BYTES="$disk_bytes" \
  H_SEC="$disk_sec" H_EFI="$efi" H_WIFI="$wifi" H_USER="$username" H_USERHASH="$user_hash" \
  H_ADMIN="$user_admin" H_ROOTHASH="$root_hash" \
  python3 - "$1" <<'PY'
import base64, glob, json, os, shlex, sys, uuid

E = os.environ
out = sys.argv[1]
profile, pdir, extras, url = E["H_PROFILE"], E["H_PDIR"], E["H_EXTRAS"], E["H_URL"]
desktop = E["H_DESKTOP"]
username, user_hash, admin = E["H_USER"], E["H_USERHASH"], E["H_ADMIN"] == "1"
root_hash = E["H_ROOTHASH"]


def read_list(p):
    if not os.path.isfile(p):
        return []
    with open(p, encoding="utf-8") as f:
        return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]


def write_cmd(src, dest, mode=None):
    with open(src, "rb") as f:
        b64 = base64.b64encode(f.read()).decode()
    d = shlex.quote(dest)
    cmd = f"mkdir -p {shlex.quote(os.path.dirname(dest))} && echo {b64} | base64 -d > {d}"
    if mode:
        cmd += f" && chmod {mode} {d}"
    return cmd


def file_commands(root):
    """<profil>/files/<yol> içindeki her dosyayı hedef sistemde /<yol> olarak yazar."""
    base = os.path.join(root, "files")
    cmds = []
    for dirpath, _, names in sorted(os.walk(base)):
        for name in sorted(names):
            src = os.path.join(dirpath, name)
            cmds.append(write_cmd(src, "/" + os.path.relpath(src, base)))
    return cmds


efi = E["H_EFI"] == "1"
disk_dev = E["H_DISK"]
packages, services, commands = [], [], []
for part in ("common", profile):
    root = os.path.join(pdir, part)
    packages += read_list(os.path.join(root, "packages"))
    services += read_list(os.path.join(root, "services"))
    commands += file_commands(root)

if E["H_WIFI"] == "1":
    packages.append("wpa_supplicant")

# Masaüstü ortamı — yalnızca Workstation profilinde sorulur.
# Ortak ses/görüntü paketleri: PipeWire ve Mesa.
if desktop == "kde":
    packages += ["plasma-meta", "plasma-login-manager", "pipewire", "pipewire-pulse", "wireplumber", "mesa", "noto-fonts"]
    services += ["plasmalogin"]
elif desktop == "gnome":
    packages += ["gnome", "gnome-tweaks", "gdm", "pipewire", "pipewire-pulse", "wireplumber", "mesa", "noto-fonts"]
    services += ["gdm"]

if desktop:
    commands.append("systemctl set-default graphical.target")

# Canlı ortamda kurulan ağ bağlantıları (Wi-Fi parolası dahil) hedef sisteme taşınır.
for src in sorted(glob.glob("/etc/NetworkManager/system-connections/*")):
    if os.path.isfile(src):
        commands.append(write_cmd(src, "/etc/NetworkManager/system-connections/" + os.path.basename(src), "600"))

if "nftables" in packages:
    commands.append(
        "nft -c -f /etc/nftables.conf "
        "|| echo 'HorOS: UYARI: guvenlik duvari kurallari dogrulanamadi, /etc/nftables.conf dosyasini kontrol et'"
    )

# Hesaplar
if username:
    grp = "-G wheel " if admin else ""
    commands.append(f"useradd -m {grp}-s /bin/bash {username}")
    commands.append(f"echo '{username}:{user_hash}' | chpasswd -e")
    if admin:
        packages.append("sudo")
        commands.append(
            "echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel "
            "&& chmod 440 /etc/sudoers.d/10-wheel"
        )
if root_hash:
    commands.append(f"echo 'root:{root_hash}' | chpasswd -e")
else:
    commands.append("passwd -l root")

commands += [f"systemctl enable {s}" for s in services]

# Önyükleyici: her zaman GRUB (UEFI + BIOS). archinstall'a açıkça söylenir; ayrıca aşağıdaki
# yedek adım, archinstall önyükleyiciyi kurmadıysa veya UEFI NVRAM kaydı kalıcı değilse
# (sanal makinelerde sık) diski yine de açılabilir yapar.
packages += ["grub"] + (["efibootmgr"] if efi else [])
if efi:
    commands.append(
        "if [ ! -f /boot/loader/loader.conf ]; then "
        "[ -f /boot/EFI/BOOT/BOOTX64.EFI ] || "
        "grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=HorOS --removable "
        "|| echo 'HorOS: UYARI: GRUB (UEFI) kurulamadi'; fi; true"
    )
else:
    commands.append(
        f"[ -f /boot/grub/i386-pc/core.img ] || grub-install --target=i386-pc {shlex.quote(disk_dev)} "
        "|| echo 'HorOS: UYARI: GRUB (BIOS) kurulamadi'; true"
    )

# Marka: kurulan sistemde os-release/issue ve önyükleyici menüsü "HorOS Linux" yazar
# (archinstall varsayılan olarak "Arch Linux" yazar). Hatalar kurulumu durdurmaz.
def write_text(dest, text):
    b64 = base64.b64encode(text.encode()).decode()
    return f"echo {b64} | base64 -d > {shlex.quote(dest)}"


osrel = ""
if os.path.isfile("/etc/os-release"):
    with open("/etc/os-release", encoding="utf-8") as f:
        osrel = f.read()
if "HorOS" in osrel:
    commands.append("rm -f /etc/os-release && " + write_text("/etc/os-release", osrel) + "; true")
commands.append(write_text("/etc/issue", "HorOS Linux \\r (\\l)\n\n") + "; true")
# GRUB (BIOS kurulumları): GRUB_DISTRIBUTOR menü adını belirler; menüyü yeniden üret.
commands.append(
    "if [ -f /etc/default/grub ]; then mkdir -p /boot/grub; "
    "sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=\"HorOS\"/' /etc/default/grub; "
    "grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub || echo 'GRUB_DISTRIBUTOR=\"HorOS\"' >> /etc/default/grub; "
    "grub-mkconfig -o /boot/grub/grub.cfg; "
    "sed -i -e 's#HorOS GNU/Linux#HorOS Linux#g' -e 's#Arch Linux#HorOS Linux#g' /boot/grub/grub.cfg; "
    "fi; true"
)
# systemd-boot (UEFI kurulumları): giriş başlıkları
commands.append(
    "for f in /boot/loader/entries/*.conf; do "
    "[ -f \"$f\" ] && sed -i 's/^\\(title[[:space:]]\\+\\)Arch Linux/\\1HorOS Linux/' \"$f\"; "
    "done; true"
)

if extras:
    packages += ["python", "git"]
    commands.append(
        f"curl -fsSL {url} | bash -s -- --extras {extras} "
        f"|| echo 'HorOS: limon kurulamadi. Sonra elle kur: curl -fsSL {url} | bash'"
    )

# Disk düzeni: UEFI için ESP + ext4 kök; BIOS için FAT32 /boot (boot bayraklı) + ext4 kök.
# archinstall her oluşturduğu bölümde dosya sistemi bekler; BIOS'ta da önyükleyici bölümü şarttır.
# Tüm disk silinir.
sec = int(E["H_SEC"])
total_mib = int(E["H_BYTES"]) // (1024 * 1024)

def size_of(mib):
    return {"sector_size": {"unit": "B", "value": sec}, "unit": "MiB", "value": mib}


def part(start, size, fs, flags, mount):
    return {
        "btrfs": [], "dev_path": None, "flags": flags, "fs_type": fs, "mount_options": [],
        "mountpoint": mount, "obj_id": str(uuid.uuid4()), "size": size_of(size),
        "start": size_of(start), "status": "create", "type": "primary",
    }


if efi:
    parts = [part(1, 512, "fat32", ["boot", "esp"], "/boot"),
             part(513, total_mib - 513 - 1, "ext4", [], "/")]
else:
    parts = [part(1, 1024, "fat32", ["boot"], "/boot"),
             part(1025, total_mib - 1025 - 1, "ext4", [], "/")]

config = {
    # Eski şema ("bootloader") ve yeni şema ("bootloader_config"): archinstall bilmediğini yok sayar.
    "bootloader": "Grub",
    "bootloader_config": {"bootloader": "Grub", "uki": False, "removable": True},
    "hostname": E["H_HOST"],
    "packages": list(dict.fromkeys(packages)),
    "custom_commands": commands,
    "timezone": E["H_TZ"] or "UTC",
    "locale_config": {"kb_layout": E["H_KB"], "sys_lang": "en_US", "sys_enc": "UTF-8"},
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": [{"device": E["H_DISK"], "partitions": parts, "wipe": True}],
    },
}
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(config, f, indent=2, ensure_ascii=False)
PY
}

# Kurulum bitince diski salt-okunur bağlayıp çekirdek, initramfs ve önyükleyici dosyalarını arar.
verify_boot() {
  local m efi=0 parts=() boot root problems=()
  [[ -d /sys/firmware/efi ]] && efi=1
  umount -R /mnt 2>/dev/null || true
  mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part"{print $1}')
  if (( ${#parts[@]} < 2 )); then
    echo "${R}UYARI:${N} $disk üzerinde beklenen bölümler bulunamadı."; return 1
  fi
  # İlk bölüm her iki düzende de /boot (UEFI'de ESP, BIOS'ta FAT32 boot).
  boot="${parts[0]}"; root="${parts[-1]}"
  m="$(mktemp -d /tmp/horos-verify.XXXXXX)"
  if ! mount -o ro "$root" "$m" 2>/dev/null; then
    echo "${R}UYARI:${N} kök bölüm ($root) bağlanamadı."; rmdir "$m"; return 1
  fi
  mount -o ro "$boot" "$m/boot" 2>/dev/null || problems+=("boot bölümü ($boot) bağlanamadı")
  [[ -s "$m/boot/vmlinuz-linux" ]]        || problems+=("çekirdek yok (/boot/vmlinuz-linux)")
  [[ -s "$m/boot/initramfs-linux.img" ]]  || problems+=("initramfs yok (/boot/initramfs-linux.img)")
  [[ -f "$m/boot/grub/grub.cfg" || -f "$m/boot/loader/loader.conf" ]] \
    || problems+=("önyükleyici yapılandırması yok (grub.cfg)")
  if (( efi )); then
    find "$m/boot/EFI" -iname '*.efi' 2>/dev/null | grep -q . || problems+=("EFI önyükleyici dosyası yok")
  else
    [[ -f "$m/boot/grub/i386-pc/core.img" ]] || problems+=("GRUB (BIOS) core.img yok")
  fi
  umount -R "$m" 2>/dev/null || true
  rmdir "$m" 2>/dev/null || true
  if (( ${#problems[@]} > 0 )); then
    echo "${R}Önyükleme doğrulaması başarısız:${N}"
    printf '  - %s\n' "${problems[@]}"
    echo "Kayıt: /var/log/archinstall/install.log"
    return 1
  fi
  echo "${G}Önyükleme doğrulandı:${N} çekirdek, initramfs ve önyükleyici yerinde."
  return 0
}

begin_install() {
  local missing=()
  [[ -z "$disk" ]] && missing+=("Kurulum hedefi")
  admin_ok || missing+=("Yönetici hesap (kullanıcı oluştur veya root parolası belirle)")
  if [[ -z "$DRYRUN" ]]; then
    echo "Ağ denetleniyor..."
    if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; missing+=("İnternet bağlantısı (7 numaralı maddeden ağı ayarla)"); fi
  fi
  if (( ${#missing[@]} > 0 )); then
    echo
    echo "${R}Önce tamamlanması gerekenler:${N}"
    printf '  - %s\n' "${missing[@]}"
    pause 3
    return 99
  fi

  echo
  echo "${Y}Kurulacak sistem${N}"
  echo "  Profil      : $(profile_title "$profile")"
  echo "  Masaüstü    : $(desktop_label)"
  echo "  Disk        : $disk ($(human_size "$disk_bytes")) — ${R}TÜM VERİLER SİLİNECEK${N}"
  echo "  Önyükleme   : $([[ -d /sys/firmware/efi ]] && echo UEFI || echo BIOS)"
  echo "  Makine adı  : $hostname_v   Saat dilimi: $timezone   Klavye: $kb   Dil: en_US.UTF-8"
  echo "  Kullanıcı   : ${username:-yok}$( ((user_admin)) && [[ -n "$username" ]] && echo ' (sudo)')   Root: $([[ -n "$root_hash" ]] && echo parolalı || echo kilitli)"
  echo "  limon       : $(limon_label)"
  echo
  local answer
  read -rp "Devam etmek için INSTALL yaz: " answer || return 1
  if [[ "$answer" != "INSTALL" ]]; then
    echo "Vazgeçildi."; pause; return 99
  fi

  local cfg
  cfg="$(mktemp --suffix=.json /tmp/horos-archinstall.XXXXXX)"
  if ! generate_config "$cfg"; then
    echo "HATA: yapılandırma üretilemedi." >&2
    rm -f "$cfg"; return 1
  fi

  if [[ -n "$DRYRUN" ]]; then
    echo "DRYRUN: yapılandırma yazıldı, kurulum yapılmadı: $cfg"
    return 0
  fi

  echo
  prepare_pacman || { rm -f "$cfg"; return 1; }
  umount -R /mnt 2>/dev/null || true
  swapoff -a 2>/dev/null || true

  echo
  echo "Kurulum başlıyor..."
  local rc=0
  archinstall --config "$cfg" --silent || rc=$?
  rm -f "$cfg"
  if (( rc == 0 )); then
    echo
    verify_boot || rc=3
  fi
  return "$rc"
}

# ---------------------------------------------------------------- ana akış
main() {
  if [[ $EUID -ne 0 ]]; then
    echo "Kurulum aracı root olarak çalıştırılmalı."; exit 1
  fi
  if [[ -z "$DRYRUN" ]] && ! command -v archinstall >/dev/null; then
    echo "archinstall bulunamadı." >&2; exit 1
  fi

  # Varsayılan profil: ilk klasör
  profile="$(find "$PROFILE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name common -printf '%f\n' 2>/dev/null | sort | head -n1)"
  if [[ -z "$profile" ]]; then
    echo "Profil dizini bulunamadı: $PROFILE_DIR" >&2; exit 1
  fi

  # Ekran hemen açılır: ağ/konum tespiti arka planda, klavye parola yazılmadan önce onaylanır.
  trap '[[ -n "$DETECT_DIR" ]] && rm -rf "$DETECT_DIR"' EXIT
  kb=us
  start_detect

  local c rc st buf="" redraw=1 targs
  while true; do
    if (( redraw )); then show_hub; printf 'Seçim: '; buf=""; fi
    redraw=1
    targs=(); (( detect_done )) || targs=(-t 1)
    read -r "${targs[@]}" c; st=$?
    if (( st > 128 )); then          # zaman aşımı: yazılmakta olan girdiyi koru
      buf+="$c"
      if apply_detect; then redraw=1; else redraw=0; fi
      continue
    fi
    if (( st != 0 )); then sleep 1; continue; fi
    c="$buf$c"; buf=""
    case "$c" in
      1) set_keyboard ;;
      2) set_timezone ;;
      3) set_profile ;;
      4) set_desktop ;;
      5) set_limon ;;
      6) set_disk ;;
      7) set_network ;;
      8) set_root ;;
      9) set_user ;;
      b|B) begin_install; rc=$?
           (( rc == 99 )) && continue
           return "$rc" ;;
      q|Q) echo "Vazgeçildi."; exit 130 ;;
      *) echo "Geçersiz seçim."; pause ;;
    esac
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
