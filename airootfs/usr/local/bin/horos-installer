#!/usr/bin/env bash
# HorOS Linux — kurulum arayüzü
# Fedora (Anaconda) tarzı "Kurulum Özeti" ekranı; arka uçta archinstall --silent çalışır.
# Test için: HOROS_DRYRUN=1 horos-installer  (yapılandırmayı yazar, diske dokunmaz)
set -uo pipefail
export LC_ALL=C.UTF-8   # ${#var} karakter saysın (Türkçe harflerle hizalama)

# Kurulum betiği kaynak ağacın içinde çalışır (pip install -e .): önce depoyu klonlarız.
LIMON_REPO="https://github.com/horoslinux/limon.git"
PROFILE_DIR="${HOROS_PROFILE_DIR:-/usr/share/horos/profiles}"
KEYMAP_DIR="${KEYMAP_DIR:-/usr/share/kbd/keymaps}"
DRYRUN="${HOROS_DRYRUN:-}"

Y=$'\e[1;33m'; R=$'\e[1;31m'; G=$'\e[1;32m'; D=$'\e[2m'; N=$'\e[0m'

# ---- Durum (özet ekranındaki her satır bir değişken) ----
kb=us; timezone=UTC; tz_src="varsayılan"; country=""
profile=""; extras=""; desktop=""
disk=""; disk_bytes=0; disk_sec=512
# Kurulum modu: "full" = tüm diski sil; "partial" = mevcut bölümleri koru, boş alana kur.
disk_mode="full"; partial_start=0; partial_size=0
partial_esp=""; partial_esp_start=0; partial_esp_size=0; partial_esp_fs="fat32"
hostname_v="horos"; net_state="denetleniyor..."
root_hash=""; username=""; user_hash=""; user_admin=1
PW_HASH=""
kb_ok=0; detect_done=0; limon_asked=0; DETECT_DIR=""
# Takas varsayılan olarak açık; boyut kurulum ortamının RAM'ine göre seçilir.
swap_on=1; swap_mib=0
# Donanıma göre eklenen sürücü paketleri (lspci/lsusb ile algılanır).
driver_pkgs=""; driver_note="algılanmadı"

# ---------------------------------------------------------------- yardımcılar
# ICMP engellenmiş ağlarda yanlış "bağlantı yok" dememek için ping + HTTPS denetimi.
have_net() {
  ping -c1 -W2 archlinux.org &>/dev/null && return 0
  curl -fsS --max-time 4 -o /dev/null https://archlinux.org/ &>/dev/null
}

ip_lookup() { # $1: alan (timezone | country)
  local url val
  for url in "https://ipapi.co/$1" "https://ipinfo.io/$1"; do
    val="$(curl -fsS --max-time 4 "$url" 2>/dev/null | tr -d '[:space:]')" || continue
    if [[ "$val" =~ ^[A-Za-z0-9_+/-]+$ ]]; then echo "$val"; return 0; fi
  done
  return 1
}

keymap_for_country() {
  case "$1" in
    TR) echo trq ;;       US) echo us ;;         GB) echo uk ;;
    DE|AT) echo de-latin1 ;;  FR) echo fr ;;     ES) echo es ;;
    IT) echo it ;;        PT) echo pt-latin1 ;;  BR) echo br-abnt2 ;;
    NL) echo nl ;;        BE) echo be-latin1 ;;  CH) echo sg-latin1 ;;
    SE) echo sv-latin1 ;; NO) echo no ;;         DK) echo dk ;;
    FI) echo fi ;;        PL) echo pl ;;         CZ) echo cz-lat2 ;;
    RU) echo ru ;;        UA) echo ua ;;         GR) echo gr ;;
    HU) echo hu ;;        RO) echo ro ;;         IE) echo ie ;;
    JP) echo jp106 ;;
    *) echo us ;;
  esac
}

keymap_exists() {
  [[ -d "$KEYMAP_DIR" ]] || return 0   # doğrulanamıyorsa engelleme
  find "$KEYMAP_DIR" -type f \( -name "$1.map" -o -name "$1.map.gz" \) 2>/dev/null | grep -q .
}

profile_title() {
  local f="$PROFILE_DIR/$1/title"
  if [[ -f "$f" ]]; then head -n1 "$f"; else echo "$1"; fi
}

profile_short() { profile_title "$1" | sed 's/ —.*//'; }

limon_label() {
  # limon tabanı her kurulumda gelir; extras yalnızca provider SDK'larını ekler.
  case "$extras" in
    all)    echo "Kurulu (Claude, OpenAI, Gemini)" ;;
    claude) echo "Kurulu (Claude)" ;;
    openai) echo "Kurulu (OpenAI)" ;;
    gemini) echo "Kurulu (Gemini)" ;;
    *)      echo "Kurulu (temel; provider sonra: limon config)" ;;
  esac
}

desktop_label() {
  if [[ "$profile" != workstation ]]; then
    echo "— (yalnızca Workstation)"
    return
  fi
  case "$desktop" in
    kde) echo "KDE Plasma" ;;
    gnome) echo "GNOME" ;;
    *) echo "Kurulmayacak" ;;
  esac
}

# ---------------------------------------------------------------- takas (swap)
swap_size_for_ram() { # MiB; küçük RAM'de 2x, orta RAM'de 1x, büyük RAM'de 8 GiB
  local kb mib
  kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || true)"
  [[ "$kb" =~ ^[0-9]+$ ]] || kb=2097152
  mib=$(( kb / 1024 ))
  if (( mib <= 2048 )); then mib=$(( mib * 2 ))
  elif (( mib > 8192 )); then mib=8192
  fi
  (( mib < 512 )) && mib=512
  echo $(( (mib + 255) / 256 * 256 ))   # 256 MiB katlarına yuvarla
}

swap_label() {
  if (( swap_on )); then echo "Etkin (${swap_mib} MiB swapfile)"; else echo "Kapalı"; fi
}

set_swap() {
  local a v
  echo
  echo "Takas alanı şu an: $(swap_label)"
  echo "Not: RAM'den küçük disklerde swap dosyası yerden tasarruf için kapatılabilir."
  read -rp "Takas etkin olsun mu? [E/h]: " a || a=""
  if [[ "${a,,}" == h* ]]; then
    swap_on=0; return 0
  fi
  swap_on=1
  read -rp "Swap boyutu MiB [${swap_mib}] (0 = RAM'e göre otomatik): " v || v=""
  if [[ -n "$v" ]]; then
    if [[ "$v" =~ ^[0-9]+$ ]]; then
      v=$((10#$v))
      if (( v == 0 )); then
        swap_mib="$(swap_size_for_ram)"
      elif (( v >= 256 && v <= 65536 )); then
        swap_mib="$v"
      else
        echo "256 ile 65536 MiB arasında bir değer gir (veya 0 = otomatik)."; pause 2
      fi
    else
      echo "Geçersiz sayı."; pause 2
    fi
  fi
}

# ------------------------------------------------------------- donanım/sürücüler
detect_drivers() {
  local pci="" usb="" product="" pkgs="" names=""
  if command -v lspci >/dev/null 2>&1; then
    pci="$(lspci -nn 2>/dev/null || true)"
  elif [[ -r /proc/bus/pci/devices ]]; then
    pci="$(cat /proc/bus/pci/devices 2>/dev/null || true)"
  fi
  command -v lsusb >/dev/null 2>&1 && usb="$(lsusb 2>/dev/null || true)"
  [[ -r /sys/class/dmi/id/product_name ]] && \
    product="$(tr '[:upper:]' '[:lower:]' < /sys/class/dmi/id/product_name 2>/dev/null || true)"

  # NVIDIA: çekirdek modülü + kullanıcı alanı araçları.
  if grep -qiE '10de:|nvidia' <<<"$pci"; then
    pkgs+=" nvidia nvidia-utils nvidia-settings linux-headers"
    names+=" NVIDIA"
  fi
  # AMD/Intel GPU: mesa (Wayland/X.org için ortak sürücü yığını).
  if grep -qiE 'vga compatible|3d controller|display controller' <<<"$pci" &&
     grep -qiE '1002:|8086:' <<<"$pci"; then
    pkgs+=" mesa"
    names+=" GPU"
  fi
  # Broadcom kablosuz: extra deposundaki STA sürücüsü.
  if grep -qiE 'network controller.*\[14e4:' <<<"$pci"; then
    pkgs+=" broadcom-wl"
    names+=" Broadcom-WiFi"
  fi
  # Intel ses: Sound Open Firmware.
  if grep -qiE 'audio device.*\[8086:' <<<"$pci"; then
    pkgs+=" sof-firmware"
    names+=" Intel-audio"
  fi
  # Sanal makine konuk araçları.
  case "$product" in
    *virtualbox*) pkgs+=" virtualbox-guest-utils"; names+=" VirtualBox" ;;
    *vmware*)     pkgs+=" open-vm-tools";          names+=" VMware" ;;
    *qemu*|*kvm*) pkgs+=" qemu-guest-agent spice-vdagent"; names+=" QEMU" ;;
  esac
  if grep -qiE 'virtualbox|vmware|qemu' <<<"$pci"; then
    grep -qi virtualbox <<<"$pci" && pkgs+=" virtualbox-guest-utils"
    grep -qi vmware     <<<"$pci" && pkgs+=" open-vm-tools"
    grep -qi qemu       <<<"$pci" && pkgs+=" qemu-guest-agent spice-vdagent"
  fi
  if grep -qi bluetooth <<<"$usb$product"; then
    pkgs+=" bluez bluez-utils"
    names+=" Bluetooth"
  fi

  driver_pkgs="$(echo $pkgs)"
  driver_note="${names#, }"
  [[ -z "$driver_note" ]] && driver_note="ek sürücü gerekmiyor"
}

pause() { sleep "${1:-1}"; }

# Ağ + konum tespiti arka planda çalışır; ekran beklemeden açılır, sonuç gelince özet güncellenir.
start_detect() {
  DETECT_DIR="$(mktemp -d /tmp/horos-detect.XXXXXX)"
  (
    n=0; tz=""; c=""
    for _ in 1 2 3 4 5 6; do
      if have_net; then n=1; break; fi
      sleep 1
    done
    if (( n )); then
      tz="$(ip_lookup timezone || true)"
      c="$(ip_lookup country || true)"
    fi
    printf 'net=%s\ntz=%s\ncountry=%s\n' "$n" "$tz" "$c" > "$DETECT_DIR/tmp" \
      && mv "$DETECT_DIR/tmp" "$DETECT_DIR/done"
  ) >/dev/null 2>&1 &
}

# Sonuç geldiyse uygular; ekranın yenilenmesi gerekiyorsa 0 döner.
apply_detect() {
  (( detect_done )) && return 1
  [[ -f "$DETECT_DIR/done" ]] || return 1
  local k v n="" t="" c="" kb2
  while IFS='=' read -r k v; do
    case "$k" in net) n="$v" ;; tz) t="$v" ;; country) c="$v" ;; esac
  done < "$DETECT_DIR/done"
  detect_done=1
  if [[ "$n" == 1 ]]; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
  if [[ -n "$t" && "$tz_src" == "varsayılan" && -f "/usr/share/zoneinfo/$t" ]]; then
    timezone="$t"; tz_src="IP'den tespit edildi"
  fi
  if [[ "$c" =~ ^[A-Z]{2}$ ]]; then
    country="$c"
    if (( ! kb_ok )); then
      kb2="$(keymap_for_country "$c")"
      keymap_exists "$kb2" && kb="$kb2"
    fi
  fi
  rm -rf "$DETECT_DIR"
  return 0
}

# ---------------------------------------------------------------- bölümler
set_keyboard() {
  local in k
  echo
  echo "Parolanı bu düzenle yazacaksın; doğru düzeni seçtiğinden emin ol."
  while true; do
    read -rp "Klavye düzeni [$kb] (Enter = kabul; örn: us, trq, trf, uk, de-latin1): " in || in=""
    k="${in:-$kb}"
    if keymap_exists "$k"; then kb="$k"; break; fi
    echo "'$k' bulunamadı. Tüm düzenler için: localectl list-keymaps"
  done
  loadkeys "$kb" 2>/dev/null || true   # parola girişleri için hemen uygula
  kb_ok=1
}

set_timezone() {
  local in z
  echo
  echo "Örnek: Europe/Istanbul, America/New_York, UTC (arama için bir parça yaz: ist)"
  while true; do
    read -rp "Saat dilimi [$timezone]: " in || in=""
    z="${in:-$timezone}"
    if [[ "$z" =~ ^[A-Za-z0-9_+/-]+$ && -f "/usr/share/zoneinfo/$z" ]]; then
      timezone="$z"; tz_src="elle seçildi"; return 0
    fi
    echo "Bulunamadı. Eşleşenler:"
    timedatectl list-timezones 2>/dev/null | grep -i -- "${z//[^A-Za-z0-9_+\/-]/}" | head -n 10 | sed 's/^/  /'
  done
}

set_profile() {
  local profiles=() p i pc
  mapfile -t profiles < <(find "$PROFILE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name common -printf '%f\n' 2>/dev/null | sort)
  (( ${#profiles[@]} > 0 )) || { echo "Profil bulunamadı: $PROFILE_DIR"; pause 2; return 0; }
  echo
  i=0
  for p in "${profiles[@]}"; do
    i=$((i + 1)); printf '  %d) %s\n' "$i" "$(profile_title "$p")"
  done
  read -rp "Seçim [1-${#profiles[@]}]: " pc || return 0
  if [[ "$pc" =~ ^[0-9]+$ ]] && (( 10#$pc >= 1 && 10#$pc <= ${#profiles[@]} )); then
    profile="${profiles[10#$pc - 1]}"
    if [[ "$profile" == workstation ]]; then
      set_desktop
    else
      desktop=""
    fi
  else
    echo "Geçersiz seçim."; pause
  fi
}

set_desktop() {
  local a
  if [[ "$profile" != workstation ]]; then
    echo
    echo "Masaüstü ortamı yalnızca Workstation profilinde seçilir."
    pause 2; return 0
  fi
  echo
  echo "KDE Plasma veya GNOME kurulsun mu? (şu an: $(desktop_label))"
  echo "  1) Kurma — yalnızca terminal"
  echo "  2) KDE Plasma"
  echo "  3) GNOME"
  read -rp "Seçim [1-3]: " a || return 0
  case "$a" in
    1) desktop="" ;;
    2) desktop=kde ;;
    3) desktop=gnome ;;
    *) echo "Geçersiz seçim."; pause ;;
  esac
}

set_limon() {
  local a
  echo
  echo "AI asistanı (limon) temel olarak her kurulumda gelir."
  echo "Root'a ve (oluşturulacaksa) normal kullanıcıya ayrı ayrı kurulur."
  echo "Hangi sağlayıcının SDK'sı da eklensin? (API anahtarını 'limon config' ile vereceksin)"
  echo "  1) Sadece temel — sağlayıcıyı sonra 'limon config' ile seç"
  echo "  2) Claude"
  echo "  3) OpenAI"
  echo "  4) Gemini"
  echo "  5) Hepsi"
  read -rp "Seçim [1-5]: " a || return 0
  limon_asked=1
  case "$a" in
    1) extras="" ;;
    2) extras=claude ;;
    3) extras=openai ;;
    4) extras=gemini ;;
    5) extras=all ;;
    *) echo "Geçersiz seçim."; pause ;;
  esac
}

# Disk listesi: yol<TAB>bayt<TAB>model<TAB>sektör  (kurulum ortamının kendi diski hariç)
list_disks() {
  local src live=""
  src="$(findmnt -rno SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -n "$src" ]]; then
    live="$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)"
    [[ -n "$live" ]] && live="/dev/$live"
  fi
  LIVE_DEV="$live" python3 - <<'PY'
import json, os, subprocess
live = os.environ.get("LIVE_DEV", "")
raw = subprocess.run(
    ["lsblk", "-J", "-b", "-d", "-p", "-o", "NAME,SIZE,MODEL,TYPE,RO,LOG-SEC"],
    capture_output=True, text=True).stdout
for d in json.loads(raw or '{"blockdevices": []}')["blockdevices"]:
    name = d.get("name") or ""
    if d.get("type") != "disk" or name == live or name.startswith("/dev/zram"):
        continue
    if str(d.get("ro")).lower() in ("1", "true"):
        continue
    size = int(d.get("size") or 0)
    sec = int(d.get("log-sec") or 512)
    model = (d.get("model") or "disk").strip()
    print(f"{name}\t{size}\t{model}\t{sec}")
PY
}

human_size() { python3 -c "import sys;b=int(sys.argv[1]);print(f'{b/1e9:.0f} GB' if b<1e12 else f'{b/1e12:.1f} TB')" "$1"; }

# Kısmi kurulum için en büyük boş alanı ve varsa EFI/boot bölümünü bulur.
# Çıktı: start_mib \t size_mib \t esp_dev \t esp_start \t esp_size \t esp_fs
find_partial_plan() { # $1 disk, $2 istenen MiB
  python3 - "$1" "$2" <<'PY'
import json, math, re, subprocess, sys

disk, want = sys.argv[1], int(sys.argv[2])
try:
    out = subprocess.run(["parted", "-jsm", disk, "unit", "MiB", "print", "free"],
                         capture_output=True, text=True, check=True)
    parts = json.loads(out.stdout).get("partitions", [])
except Exception:
    sys.exit(1)

def mib(value):
    nums = re.findall(r"-?\d+(?:\.\d+)?", str(value))
    return float(nums[0]) if nums else 0.0

free = []
for p in parts:
    if str(p.get("type", "")).lower() != "free":
        continue
    start = math.ceil(mib(p.get("start")))
    end = math.floor(mib(p.get("end")))
    if end - start >= 8192:
        free.append((end - start, start))
if not free:
    sys.exit(2)
size, start = max(free)
size = min(size, want)
if size < 8192:
    sys.exit(3)

def path(number):
    # /dev/nvme0n1 -> /dev/nvme0n1p7 ; /dev/sda -> /dev/sda7
    return f"{disk}p{number}" if disk[-1].isdigit() else f"{disk}{number}"

esp = esp_start = esp_size = 0
esp_fs = "fat32"
for p in parts:
    if str(p.get("type", "")).lower() == "free":
        continue
    flags = [str(f).lower() for f in (p.get("flags") or [])]
    fs = str(p.get("fs_type") or "fat32").lower().replace("vfat", "fat32")
    if "esp" in flags or ("boot" in flags and fs.startswith("fat")):
        number = p.get("number")
        if number:
            esp = path(str(number))
            esp_start = math.ceil(mib(p.get("start")))
            esp_size = math.floor(mib(p.get("size")))
            esp_fs = fs
        break

print(start, size, esp, esp_start, esp_size, esp_fs, sep="\t")
PY
}

set_disk() {
  local lines=() l i=0 pc name size model sec pm psz psz_gb plan=""
  mapfile -t lines < <(list_disks)
  if (( ${#lines[@]} == 0 )); then
    echo; echo "Kurulabilecek disk bulunamadı."; pause 2; return 0
  fi
  echo
  echo "Kurulum hedefi — disk seçildikten sonra bölümleme yöntemini soracağım."
  for l in "${lines[@]}"; do
    i=$((i + 1))
    IFS=$'\t' read -r name size model sec <<<"$l"
    printf '  %d) %s  %s  %s\n' "$i" "$name" "$(human_size "$size")" "$model"
  done
  read -rp "Seçim [1-${#lines[@]}]: " pc || return 0
  if [[ ! "$pc" =~ ^[0-9]+$ ]] || (( 10#$pc < 1 || 10#$pc > ${#lines[@]} )); then
    echo "Geçersiz seçim."; pause; return 0
  fi
  IFS=$'\t' read -r name size model sec <<<"${lines[10#$pc - 1]}"
  if (( size < 8 * 1024 * 1024 * 1024 )); then
    echo "Disk çok küçük (en az 8 GB gerekir)."; pause 2; return 0
  fi
  disk="$name"; disk_bytes="$size"; disk_sec="$sec"

  echo
  echo "Bölümleme yöntemi:"
  echo "  1) Tüm diski sil ve otomatik bölümlendir (eski yöntem)"
  echo "  2) Mevcut bölümleri koru, boş alana kur (çift sistem / veri korunur)"
  read -rp "Seçim [1-2]: " pm || pm=1
  if [[ "$pm" == "2" ]]; then
    # Kullanıcı GB girer; archinstall MiB bekler. 20 / 20G / 20GB aynı anlam.
    read -rp "Ayrılacak alan GB [100]: " psz || psz=""
    [[ -z "$psz" ]] && psz="100"
    psz_gb="${psz^^}"
    psz_gb="${psz_gb%GIB}"
    psz_gb="${psz_gb%GB}"
    psz_gb="${psz_gb%G}"
    if [[ ! "$psz_gb" =~ ^[0-9]+$ ]] || (( 10#$psz_gb < 8 )); then
      echo "Geçersiz boyut (en az 8 GB; örn. 20, 20G veya 100GB)."; pause 2; return 0
    fi
    psz=$(( 10#$psz_gb * 1024 ))   # MiB
    if ! plan="$(find_partial_plan "$disk" "$psz")"; then
      echo "${R}Yeterli boş alan bulunamadı.${N} Diski Windows'tan küçültüp boş alan oluştur."
      pause 3; return 0
    fi
    IFS=$'\t' read -r partial_start partial_size partial_esp partial_esp_start partial_esp_size partial_esp_fs <<<"$plan"
    disk_mode="partial"
    echo "${G}Plan:${N} $partial_start MiB konumundan $partial_size MiB ($(( partial_size / 1024 )) GB) alan kullanılacak."
    if [[ -n "$partial_esp" ]]; then
      echo "Mevcut EFI/boot bölümü yeniden kullanılacak: $partial_esp"
    else
      echo "Yeni EFI/boot bölümü bu alanın içine oluşturulacak."
    fi
    pause 2
  else
    disk_mode="full"
    partial_start=0; partial_size=0; partial_esp=""
    partial_esp_start=0; partial_esp_size=0; partial_esp_fs="fat32"
  fi
}

set_network() {
  local in h
  echo
  if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
  echo "Ağ durumu: $net_state"
  read -rp "Ağ ayarlarını aç (nmtui, Wi-Fi için)? [e/H]: " in || in=""
  if [[ "${in,,}" == e* ]]; then
    nmtui || true
    if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; fi
  fi
  while true; do
    read -rp "Ana makine adı [$hostname_v]: " in || in=""
    h="${in:-$hostname_v}"
    if [[ "$h" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then hostname_v="$h"; break; fi
    echo "Geçersiz ad (küçük harf, rakam ve '-' kullan)."
  done
}

# Parolayı iki kez sorar; yescrypt/sha512 özetini PW_HASH'e yazar. Boş giriş = vazgeç.
ask_password() { # $1: etiket
  local p1 p2
  (( kb_ok )) || set_keyboard   # yanlış düzen parolayı bozar: yazmadan önce onayla
  while true; do
    read -rsp "Parola ($1; en az 8 karakter, boş = vazgeç): " p1 || return 1; echo
    [[ -z "$p1" ]] && return 1
    if (( ${#p1} < 8 )); then echo "En az 8 karakter olmalı."; continue; fi
    read -rsp "Parolayı tekrar yaz: " p2 || return 1; echo
    [[ "$p1" == "$p2" ]] && break
    echo "Parolalar eşleşmiyor."
  done
  PW_HASH="$(printf '%s' "$p1" | openssl passwd -6 -stdin)" || return 1
  [[ "$PW_HASH" == '$6$'* ]]
}

set_root() {
  local a
  echo
  echo "Root hesabı:"
  echo "  1) Kilitli (önerilen) — yönetim için sudo'lu kullanıcı kullanılır"
  echo "  2) Root parolası belirle"
  read -rp "Seçim [1-2]: " a || return 0
  case "$a" in
    1) root_hash="" ;;
    2) if ask_password "root"; then root_hash="$PW_HASH"; else echo "Vazgeçildi."; pause; fi ;;
    *) echo "Geçersiz seçim."; pause ;;
  esac
}

set_user() {
  local u a
  echo
  read -rp "Kullanıcı adı [boş = vazgeç]: " u || return 0
  [[ -z "$u" ]] && return 0
  if [[ ! "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ || "$u" == root ]]; then
    echo "Geçersiz kullanıcı adı (küçük harf, rakam, '_' ve '-')."; pause 2; return 0
  fi
  ask_password "kullanıcı $u" || { echo "Vazgeçildi."; pause; return 0; }
  read -rp "Yönetici (sudo) olsun mu? [E/h]: " a || a=""
  username="$u"; user_hash="$PW_HASH"
  if [[ "${a,,}" == h* ]]; then user_admin=0; else user_admin=1; fi
}

# ---------------------------------------------------------------- özet ekranı
show_banner() {
  clear
  cat <<'BANNER'
 _   _            ___  ____
| | | | ___  _ __/ _ \/ ___|
| |_| |/ _ \| '__| | | \___ \
|  _  | (_) | |  | |_| |___) |
|_| |_|\___/|_|   \___/|____/
BANNER
  echo
}

row() { # $1 numara, $2 etiket, $3 değer, $4 uyarı (varsa)
  printf ' %s) %s%*s %s%s\n' "$1" "$2" $((26 - ${#2})) "" "$3" "${4:+  ${R}$4${N}}"
}

admin_ok() { [[ -n "$root_hash" ]] || { [[ -n "$username" ]] && (( user_admin == 1 )); }; }

show_hub() {
  local disk_v user_v root_v warn_d="" warn_u="" warn_n=""
  if [[ -n "$disk" ]]; then
    if [[ "$disk_mode" == "partial" ]]; then
      disk_v="$disk ($(human_size "$disk_bytes")) — ${partial_size} MiB alan, mevcut bölümler korunur"
    else
      disk_v="$disk ($(human_size "$disk_bytes")) — tüm disk silinir"
    fi
  else disk_v="seçilmedi"; warn_d="(!) tamamlanmalı"; fi
  if [[ -n "$username" ]]; then user_v="$username$( ((user_admin)) && echo ' (yönetici)' )"
  else user_v="oluşturulmadı"; fi
  admin_ok || warn_u="(!) yönetici hesap gerekli"
  [[ "$net_state" == "Bağlı değil" ]] && warn_n="(!) kurulum için ağ gerekli"
  if [[ -n "$root_hash" ]]; then root_v="Parola belirlendi"; else root_v="Kilitli"; fi

  show_banner
  echo "${Y}KURULUM ÖZETİ${N}"
  echo
  echo "${Y}YEREL AYARLAR${N}"
  row 1 "Klavye"               "$kb$( ((kb_ok)) || echo " ${D}(önerilen, onaylanmadı)${N}")"
  row 2 "Saat dilimi"          "$timezone ${D}($tz_src)${N}"
  echo "${Y}YAZILIM${N}"
  row 3 "Kurulum profili"      "$(profile_short "$profile")"
  row 4 "Masaüstü ortamı"      "$(desktop_label)"
  row 5 "AI asistanı (limon)"  "$(limon_label)"
  printf '  Sürücüler           : %s\n' "$driver_note"
  echo "${Y}SİSTEM${N}"
  row 6 "Kurulum hedefi"       "$disk_v" "$warn_d"
  row 7 "Ağ ve makine adı"     "$net_state · $hostname_v" "$warn_n"
  echo "${Y}KULLANICI AYARLARI${N}"
  row 8 "Root hesabı"          "$root_v"
  row 9 "Kullanıcı oluştur"    "$user_v" "$warn_u"
  echo "${Y}EK AYARLAR${N}"
  row 10 "Takas alanı"         "$(swap_label)"
  echo
  echo " ${G}b${N}) Kurulumu başlat      ${D}q) Vazgeç${N}"
  echo
}

# ---------------------------------------------------------------- kurulum hazırlığı
wait_unit() { # $1 unit, $2 mesaj, $3 en fazla saniye
  local unit="$1" msg="$2" max="${3:-90}" i=0 st
  while (( i < max )); do
    st="$(systemctl is-active "$unit" 2>/dev/null || true)"
    case "$st" in activating|reloading) ;; *) return 0 ;; esac
    (( i == 0 )) && echo "$msg"
    sleep 1; i=$((i + 1))
  done
  echo "UYARI: $unit $max saniyede bitmedi, devam ediliyor." >&2
}

prepare_pacman() {
  wait_unit pacman-init.service "Pacman anahtar deposu hazırlanıyor..." 120
  wait_unit reflector.service   "Mirror listesi güncelleniyor..." 90

  if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" != yes ]]; then
    echo "Saat eşitleniyor..."
    timedatectl set-ntp true 2>/dev/null || true
    local i
    for i in $(seq 1 15); do
      [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" == yes ]] && break
      sleep 1
    done
  fi

  echo "Paket veritabanı eşitleniyor..."
  local out
  if out="$(pacman -Sy 2>&1)"; then return 0; fi

  echo "İlk deneme başarısız oldu:" >&2
  tail -n 6 <<<"$out" | sed 's/^/  /' >&2

  if grep -qiE 'signature|pgp|keyring|unknown trust|key ' <<<"$out"; then
    echo "Anahtar deposu yeniden hazırlanıyor..."
    pacman-key --init >/dev/null 2>&1 || true
    pacman-key --populate archlinux >/dev/null 2>&1 || true
  fi
  if grep -qiE 'failed retrieving|could not resolve|resolve host|404|timed out|timeout|no servers|failed to connect|connection' <<<"$out"; then
    echo "Mirror listesi sabit bir mirror'a çevriliyor..."
    printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist
  fi

  if out="$(pacman -Sy 2>&1)"; then return 0; fi
  echo >&2
  echo "HATA: Paket veritabanı eşitlenemedi. Kurulum bu yüzden başlayamaz." >&2
  tail -n 8 <<<"$out" | sed 's/^/  /' >&2
  echo >&2
  echo "Kontrol et: 'systemctl status pacman-init reflector', 'timedatectl', 'ping archlinux.org'" >&2
  return 1
}

# ---------------------------------------------------------------- archinstall yapılandırması
# Disk düzeni, saat dilimi, dil ve ana makine adı archinstall'a verilir; kullanıcı, parola, güvenlik
# duvarı ve servisler custom_commands ile kurulan sistemde yapılır (archinstall sürümleri arasında
# şeması en kararlı olan yol).
generate_config() { # $1: çıktı dosyası
  local efi=0 wifi=0
  [[ -d /sys/firmware/efi ]] && efi=1
  [[ -n "${HOROS_EFI:-}" ]] && efi="$HOROS_EFI"   # yalnızca test için
  compgen -G '/sys/class/net/*/wireless' >/dev/null && wifi=1

  H_PROFILE="$profile" H_PDIR="$PROFILE_DIR" H_EXTRAS="$extras" \
  H_REPO="$LIMON_REPO" H_DESKTOP="$desktop" \
  H_TZ="$timezone" H_KB="$kb" H_HOST="$hostname_v" H_DISK="$disk" H_BYTES="$disk_bytes" \
  H_SEC="$disk_sec" H_EFI="$efi" H_WIFI="$wifi" H_USER="$username" H_USERHASH="$user_hash" \
  H_ADMIN="$user_admin" H_ROOTHASH="$root_hash" \
  H_MODE="$disk_mode" H_PART_START="$partial_start" H_PART_SIZE="$partial_size" \
  H_ESP_DEV="$partial_esp" H_ESP_START="$partial_esp_start" H_ESP_SIZE="$partial_esp_size" \
  H_ESP_FS="$partial_esp_fs" \
  H_SWAP="$swap_on" H_SWAP_MIB="$swap_mib" H_DRIVERS="$driver_pkgs" \
  python3 - "$1" <<'PY'
import glob, json, os, shlex, shutil, sys, uuid

E = os.environ
out = sys.argv[1]
profile, pdir, extras = E["H_PROFILE"], E["H_PDIR"], E["H_EXTRAS"]
repo, desktop = E["H_REPO"], E["H_DESKTOP"]
username, user_hash, admin = E["H_USER"], E["H_USERHASH"], E["H_ADMIN"] == "1"
root_hash = E["H_ROOTHASH"]
swap_on = E["H_SWAP"] == "1"
swap_mib = int(E["H_SWAP_MIB"] or 0)

mode = E.get("H_MODE", "full")
part_start = int(E.get("H_PART_START") or 0)
part_size = int(E.get("H_PART_SIZE") or 0)
esp_dev = E.get("H_ESP_DEV", "")
esp_start = int(E.get("H_ESP_START") or 0)
esp_size = int(E.get("H_ESP_SIZE") or 0)
esp_fs = E.get("H_ESP_FS") or "fat32"
if esp_fs not in ("fat32", "fat16"):
    esp_fs = "fat32"


def read_list(p):
    if not os.path.isfile(p):
        return []
    with open(p, encoding="utf-8") as f:
        return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]


# Dosyalari base64 olarak archinstall config'ine gommek yerine live sistemde
# hazirlayip kurulum sonrasi hedef diske cp -a ile kopyaliyoruz. Boylece
# archinstall'in "Executing custom command ..." logunda devasa base64 bloklari
# akmıyor; config okunabilir kalıyor.
STAGE = "/tmp/horos-branding"
POST = "/tmp/horos-post-actions.sh"
shutil.rmtree(STAGE, ignore_errors=True)
os.makedirs(STAGE, exist_ok=True)
post_actions = []


def staged(dest):
    return os.path.join(STAGE, dest.lstrip("/"))


def write_cmd(src, dest, mode=None):
    p = staged(dest)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    shutil.copyfile(src, p)
    if mode:
        os.chmod(p, int(mode, 8))
    return ":"


def add_post(cmd):
    post_actions.append(cmd)
    return ":"


def file_commands(root):
    """<profil>/files/<yol> içindeki her dosyayı hedef sistemde /<yol> olarak yazar."""
    base = os.path.join(root, "files")
    cmds = []
    for dirpath, _, names in sorted(os.walk(base)):
        for name in sorted(names):
            src = os.path.join(dirpath, name)
            cmds.append(write_cmd(src, "/" + os.path.relpath(src, base)))
    return cmds


efi = E["H_EFI"] == "1"
disk_dev = E["H_DISK"]
packages, services, commands = [], [], []
for part in ("common", profile):
    root = os.path.join(pdir, part)
    packages += read_list(os.path.join(root, "packages"))
    services += read_list(os.path.join(root, "services"))
    commands += file_commands(root)

# Kablosuz, ses ve GPU firmware'u her kuruluma gelir.
# xdg-utils, HorOS kısayolundaki xdg-open çağrısının çalışması için gerekli.
packages += ["linux-firmware", "xdg-utils"]
# Canlı ortamda algılanan donanıma göre sürücüler (NVIDIA, Broadcom, sanallaştırma...).
packages += E.get("H_DRIVERS", "").split()

if E["H_WIFI"] == "1":
    packages.append("wpa_supplicant")

# Masaüstü ortamı — yalnızca Workstation profilinde sorulur.
# Ortak ses/görüntü paketleri: PipeWire ve Mesa.
if desktop == "kde":
    packages += ["plasma-meta", "plasma-login-manager", "pipewire", "pipewire-pulse", "wireplumber", "mesa", "noto-fonts", "firefox"]
    services += ["plasmalogin"]
elif desktop == "gnome":
    packages += ["gnome", "gnome-tweaks", "gdm", "pipewire", "pipewire-pulse", "wireplumber", "mesa", "noto-fonts", "firefox"]
    services += ["gdm"]

if desktop:
    commands.append("systemctl set-default graphical.target")

# Canlı ortamda kurulan ağ bağlantıları (Wi-Fi parolası dahil) hedef sisteme taşınır.
for src in sorted(glob.glob("/etc/NetworkManager/system-connections/*")):
    if os.path.isfile(src):
        commands.append(write_cmd(src, "/etc/NetworkManager/system-connections/" + os.path.basename(src), "600"))

if "nftables" in packages:
    add_post(
        "nft -c -f \"$HOROS_ROOT/etc/nftables.conf\" >/dev/null 2>&1 "
        "|| echo 'HorOS: UYARI: guvenlik duvari kurallari dogrulanamadi, /etc/nftables.conf dosyasini kontrol et'"
    )

# Hesaplar
if username:
    grp = "-G wheel " if admin else ""
    commands.append(f"useradd -m {grp}-s /bin/bash {username}")
    commands.append(f"echo '{username}:{user_hash}' | chpasswd -e")
    if admin:
        packages.append("sudo")
        commands.append(
            "echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel "
            "&& chmod 440 /etc/sudoers.d/10-wheel"
        )
if root_hash:
    commands.append(f"echo 'root:{root_hash}' | chpasswd -e")
else:
    commands.append("passwd -l root")

# Takas: ext4 kök üzerinde swapfile; bölüm düzenine dokunmaz, sürüm yükseltmelerinde kalır.
# swapon chroot içinde açık bırakılmaz: aktif swapfile kök bölümü meşgul eder, archinstall
# diski ayıramaz ve kurulum sonundaki doğrulama "kök bölüm bağlanamadı" uyarısı verir.
# Takas ilk açılışta /etc/fstab üzerinden etkinleşir.
if swap_on and swap_mib > 0:
    commands.append(
        f"(fallocate -l {swap_mib}M /swapfile "
        f"|| dd if=/dev/zero of=/swapfile bs=1M count={swap_mib} status=none) "
        "&& chmod 600 /swapfile && mkswap /swapfile "
        "&& (grep -q ' /swapfile ' /etc/fstab "
        "|| echo '/swapfile none swap defaults 0 0' >> /etc/fstab) "
        "|| echo 'HorOS: UYARI: swapfile olusturulamadi'"
    )

commands += [f"systemctl enable {s}" for s in services]

# Önyükleyici: her zaman GRUB (UEFI + BIOS). archinstall'a açıkça söylenir; ayrıca aşağıdaki
# yedek adım, archinstall önyükleyiciyi kurmadıysa veya UEFI NVRAM kaydı kalıcı değilse
# (sanal makinelerde sık) diski yine de açılabilir yapar.
packages += ["grub"] + (["efibootmgr"] if efi else [])
if efi:
    commands.append(
        "if [ ! -f /boot/loader/loader.conf ]; then "
        "[ -f /boot/EFI/BOOT/BOOTX64.EFI ] || "
        "grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=HorOS --removable "
        "|| echo 'HorOS: UYARI: GRUB (UEFI) kurulamadi'; fi; true"
    )
else:
    commands.append(
        f"[ -f /boot/grub/i386-pc/core.img ] || grub-install --target=i386-pc {shlex.quote(disk_dev)} "
        "|| echo 'HorOS: UYARI: GRUB (BIOS) kurulamadi'; true"
    )

# Marka: kurulan sistemde os-release/issue ve önyükleyici menüsü "HorOS Linux" yazar
# (archinstall varsayılan olarak "Arch Linux" yazar). Hatalar kurulumu durdurmaz.
def write_text(dest, text):
    p = staged(dest)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        f.write(text)
    return ":"


osrel = ""
if os.path.isfile("/etc/os-release"):
    with open("/etc/os-release", encoding="utf-8") as f:
        osrel = f.read()
if "HorOS" in osrel:
    commands.append("rm -f /etc/os-release && " + write_text("/etc/os-release", osrel) + "; true")
commands.append(write_text("/etc/issue", "HorOS Linux \\r (\\l)\n\n") + "; true")
# GRUB, /etc/grub.d/10_linux içindeki "Loading Linux %s ..." mesajına %s olarak
# /vmlinuz-linux dosya adından gelen "linux" değerini koyar: "Loading Linux linux".
# Bu bir hata değil, yalnızca GRUB'un mesajı; mesajı kapatıp menüyü HorOS'a göre üretiyoruz.
commands.append(
    "if [ -f /etc/grub.d/10_linux ]; then "
    "sed -i -E 's/^([[:space:]]*)message=.*Loading Linux.*/\\1message=\"\"/' /etc/grub.d/10_linux; "
    "fi; true"
)
# GRUB (BIOS kurulumları): GRUB_DISTRIBUTOR menü adını belirler; menüyü yeniden üret.
commands.append(
    "if [ -f /etc/default/grub ]; then mkdir -p /boot/grub; "
    "sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=\"HorOS\"/' /etc/default/grub; "
    "grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub || echo 'GRUB_DISTRIBUTOR=\"HorOS\"' >> /etc/default/grub; "
    "sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub; "
    "grep -q '^GRUB_DISABLE_OS_PROBER=' /etc/default/grub "
    "|| echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub; "
    "grub-mkconfig -o /boot/grub/grub.cfg; "
    "sed -i -e 's#HorOS GNU/Linux#HorOS Linux#g' -e 's#Arch Linux#HorOS Linux#g' "
    "-e '/echo.*Loading Linux/d' -e '/echo.*Loading initial ramdisk/d' /boot/grub/grub.cfg; "
    "fi; true"
)
# systemd-boot (UEFI kurulumları): giriş başlıkları
commands.append(
    "for f in /boot/loader/entries/*.conf; do "
    "[ -f \"$f\" ] && sed -i 's/^\\(title[[:space:]]\\+\\)Arch Linux/\\1HorOS Linux/' \"$f\"; "
    "done; true"
)

# Marka varlıkları: uygulama simgesi, HorOS project menü kategorisi ve duvar kağıtları.
icon_src = "/usr/share/horos/branding/horos-icon.png"
wall_dir = "/usr/share/backgrounds/horos"   # live ve hedef sistemde ayni yol
wallpapers = sorted(
    p for p in glob.glob(os.path.join(wall_dir, "*"))
    if os.path.isfile(p) and os.path.splitext(p)[1].lower() in (".jpg", ".jpeg", ".png", ".webp")
)
# Varsayilan: horos-wallpaper-NN serisinin ilk gorseli (diger ek gorseller
# listeye girer ama varsayilan olarak secilmez).
branded = [p for p in wallpapers if os.path.basename(p).startswith("horos-wallpaper-")]
wall_src = branded[0] if branded else (wallpapers[0] if wallpapers else "")
wall_dest = wall_src
if os.path.isfile(icon_src):
    commands.append(write_cmd(icon_src, "/usr/share/pixmaps/horos.png", "644"))
    commands.append(write_cmd(icon_src, "/usr/share/icons/hicolor/512x512/apps/horos.png", "644"))
    commands.append(
        "mkdir -p /usr/share/applications && "
        + write_text("/usr/share/applications/horos.desktop",
                     "[Desktop Entry]\nType=Application\nName=HorOS\nComment=HorOS Linux\n"
                     "Exec=xdg-open https://horoslinux.github.io\nIcon=horos\n"
                     "Categories=HorOS-project;\nTerminal=false\nStartupNotify=true\n")
        + " || true"
    )
    # Freedesktop menü spec: uygulama "HorOS project" alt kategorisinde görünür.
    menu_xml = "\n".join([
        '<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"',
        ' "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">',
        '<Menu>',
        '  <Name>Applications</Name>',
        '  <Menu>',
        '    <Name>HorOS-project</Name>',
        '    <Directory>horos-project.directory</Directory>',
        '    <Include>',
        '      <Category>HorOS-project</Category>',
        '    </Include>',
        '  </Menu>',
        '</Menu>',
        '',
    ])
    commands.append(" && ".join([
        "mkdir -p /usr/share/desktop-directories /etc/xdg/menus/applications-merged",
        write_text("/usr/share/desktop-directories/horos-project.directory",
                   "[Desktop Entry]\nType=Directory\nName=HorOS project\nIcon=horos\n"),
        write_text("/etc/xdg/menus/applications-merged/horos.menu", menu_xml),
    ]) + " || true")
    add_post("gtk-update-icon-cache -f -t \"$HOROS_ROOT/usr/share/icons/hicolor\" >/dev/null 2>&1 || true")
# /usr/share/backgrounds/horos icindeki tum gorselleri once hedef sisteme kopyalar,
# sonra GNOME ve KDE'nin "Arka plan" secenek listelerine kaydeder. Kanonik dosyalar
# olmadan XML'deki yollar bos onizlemeye yol acardi.
if wallpapers:
    def xml_escape(value):
        return (value.replace("&", "&amp;").replace("<", "&lt;")
                     .replace(">", "&gt;").replace('"', "&quot;"))

    def wp_label(path):
        label = os.path.splitext(os.path.basename(path))[0]
        label = label.replace("-", " ").replace("_", " ").title()
        label = label.replace("Horos", "HorOS", 1)
        if not label.lower().startswith("horos"):
            label = "HorOS " + label
        return label

    def wp_slug(value):
        slug = "".join(c if c.isalnum() else "-" for c in value).strip("-").lower()
        return slug or "horos"

    # Her gorseli bir kez /usr/share/backgrounds/horos/ altına yaz. KDE paketleri
    # ve GNOME listesi bu dosyalari gosterecek; ek kopya olmasin diye sembolik bag kullanilir.
    for path in wallpapers:
        name = os.path.basename(path)
        commands.append(write_cmd(path, os.path.join(wall_dir, name), "644"))

    gnome_xml = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">',
        '<wallpapers>',
    ]
    for path in wallpapers:
        gnome_xml += [
            '  <wallpaper deleted="false">',
            f'    <name>{xml_escape(wp_label(path))}</name>',
            f'    <filename>{path}</filename>',
            '    <options>zoom</options>',
            '    <shade_type>solid</shade_type>',
            '    <pcolor>#000000</pcolor>',
            '    <scolor>#000000</scolor>',
            '  </wallpaper>',
        ]
    gnome_xml += ['</wallpapers>', '']
    commands.append(
        "mkdir -p /usr/share/gnome-background-properties && "
        + write_text("/usr/share/gnome-background-properties/horos.xml", "\n".join(gnome_xml))
        + " || true"
    )

    for path in wallpapers:
        name = os.path.basename(path)
        stem = os.path.splitext(name)[0]
        ext = os.path.splitext(name)[1].lower()
        if stem == "horos-wallpaper":
            pkg = "horos"
        elif stem.startswith("horos"):
            pkg = wp_slug(stem)
        else:
            pkg = "horos-" + wp_slug(stem)
        image_dir = f"/usr/share/wallpapers/{pkg}/contents/images"
        canonical = os.path.join(wall_dir, name)
        image_file = f"{image_dir}/{name}"
        alias_file = f"{image_dir}/1920x1080{ext}"
        shot_file = f"/usr/share/wallpapers/{pkg}/contents/screenshot{ext}"
        meta = {
            "KPackageStructure": "Plasma/Wallpaper",
            "KPlugin": {
                "Id": pkg,
                "Name": wp_label(path),
                "Description": "HorOS Linux wallpaper",
                "License": "CC-BY-SA-4.0",
                "Authors": [{"Name": "HorOS Project"}],
            },
            "ServiceTypes": ["Plasma/Wallpaper"],
            "X-KDE-PlasmaImageWallpaper-AccentColor": "#FCC41D",
        }
        commands.append(" && ".join([
            f"mkdir -p {shlex.quote(image_dir)}",
            f"ln -sfn {shlex.quote(canonical)} {shlex.quote(image_file)}",
            f"ln -sfn {shlex.quote(canonical)} {shlex.quote(alias_file)}",
            f"ln -sfn {shlex.quote(canonical)} {shlex.quote(shot_file)}",
            write_text(f"/usr/share/wallpapers/{pkg}/metadata.json",
                       json.dumps(meta, indent=4, ensure_ascii=False) + "\n"),
        ]) + " || true")

if os.path.isfile(wall_src):
    # GNOME: sistem geneli varsayılan arka plan (kullanıcı özel ayarı yoksa geçerli).
    commands.append(
        "mkdir -p /usr/share/glib-2.0/schemas && "
        + write_text("/usr/share/glib-2.0/schemas/90_horos_wallpaper.gschema.override",
                     "[org.gnome.desktop.background]\n"
                     f"picture-uri='file://{wall_dest}'\n"
                     f"picture-uri-dark='file://{wall_dest}'\n"
                     "picture-options='zoom'\n")
        + " && glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true"
    )
    add_post("glib-compile-schemas \"$HOROS_ROOT/usr/share/glib-2.0/schemas\" >/dev/null 2>&1 || true")
    # KDE Plasma: yeni kullanıcıların masaüstü profiline HorOS duvar kağıdını yaz.
    # immutability=1 masaustu kilitler; kullanici duvar kagidi/panel degisikligi
    # yapamaz. 0 = kullanici degistirebilir (varsayilan HorOS duvar kagidi yine gelir).
    plasma = ("[Containments][1]\nactivityId=\nformfactor=0\nimmutability=0\n"
              "plugin=org.kde.plasma.desktop\nwallpaperplugin=org.kde.image\n\n"
              "[Containments][1][Wallpaper][org.kde.image][General]\n"
              f"Image=file://{wall_dest}\n")
    commands.append(
        "mkdir -p /etc/skel/.config && "
        + write_text("/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc", plasma)
        + " || true"
    )
    if username:
        home_cfg = f"/home/{username}/.config/plasma-org.kde.plasma.desktop-appletsrc"
        commands.append(
            f"mkdir -p /home/{username}/.config && "
            + write_text(home_cfg, plasma)
            + f" && chown {shlex.quote(username)}:{shlex.quote(username)} {shlex.quote(home_cfg)} || true"
        )
        # cp -a ile kopyalanan ~/.config root:root kalir; kullanici oraya yazamadigi
        # icin GNOME/KDE ayarlari reboot'ta kayboluyor. Tüm ev dizinini kullanicinin
        # yapmaliyiz (sadece plasma dosyasi degil).
        add_post(
            "arch-chroot \"$HOROS_ROOT\" chown -R "
            f"{shlex.quote(username)}:{shlex.quote(username)} /home/{shlex.quote(username)} >/dev/null 2>&1 || true"
        )

# AI-native varsayılan: limon tabanı her kuruluma gelir; extras yalnızca provider SDK'ları ekler.
# install.sh kaynak ağacın içinde çalışır (pip install -e .), bu yüzden depoyu klonlayıp içinden çalıştırırız.
# Betik HOME'a göre kurulum yapar: ~/.limon/.venv ve ~/.local/bin/limon. Bu yüzden root
# İÇİN DE, kurulum sırasında oluşturulan normal kullanıcı İÇİN DE ayrıca çalıştırılmalı.
packages += ["python", "python-pip", "git"]
# install.sh'in varsayılanı "all" olduğu için temel kurulumda bile --extras'ı açıkça geçir.
# extras boşsa "--extras=" (boş değer) temel bağımlılıkları kurar; değerler sabit listeden gelir.
extra_arg = " --extras=" + extras
repo_q = shlex.quote(repo)


def limon_install(home, label, owner=""):
    """limon'u verilen ev dizinine kurar; owner verilirse dosyalar o kullanıcıya geçer."""
    d = shlex.quote(home + "/.limon")
    h = shlex.quote(home)
    cmd = (f"git clone --depth 1 {repo_q} {d} "
           f"&& (cd {d} && HOME={h} SHELL=/bin/bash bash install.sh{extra_arg})")
    if owner:
        o = shlex.quote(owner)
        # chroot root olarak çalışır: klon, venv ve ~/.local kullanıcının olmalı.
        cmd += (f" && (chown -R {o}:{o} {d} {h}/.local; "
                f"chown -f {o}:{o} {h}/.bashrc {h}/.bash_profile {h}/.profile || true)")
    return (cmd + f" || echo 'HorOS: UYARI: limon {label} icin kurulamadi. "
            f"Sonra: git clone {repo} ~/.limon && cd ~/.limon && bash install.sh{extra_arg}'; true")


commands.append(limon_install("/root", "root"))
if username:
    # Normal kullanıcı girişinde `limon` komutunun bulunması için asıl kurulum bu.
    commands.append(limon_install(f"/home/{username}", username, username))

# Disk düzeni: UEFI için ESP + ext4 kök; BIOS için FAT32 /boot (boot bayraklı) + ext4 kök.
# "full" modu diski tamamen siler. "partial" modu mevcut bölümleri korur ve yalnızca
# seçilen boş alanda yeni bölümler oluşturur (çift sistem / veri korunur).
sec = int(E["H_SEC"])
total_mib = int(E["H_BYTES"]) // (1024 * 1024)

def size_of(mib):
    return {"sector_size": {"unit": "B", "value": sec}, "unit": "MiB", "value": mib}


def part(start, size, fs, flags, mount, status="create", dev=None):
    return {
        "btrfs": [], "dev_path": dev, "flags": flags, "fs_type": fs, "mount_options": [],
        "mountpoint": mount, "obj_id": str(uuid.uuid4()), "size": size_of(size),
        "start": size_of(start), "status": status, "type": "primary",
    }


if mode == "partial" and part_size >= 8192 and part_start >= 1:
    parts = []
    boot_flags = ["boot", "esp"] if efi else ["boot"]
    if esp_dev:
        # Var olan EFI/boot bölümü formatlanmadan bağlanır; Windows boot dosyaları korunur.
        parts.append(part(esp_start, esp_size, esp_fs, boot_flags, "/boot", "existing", esp_dev))
        root_start, root_size = part_start, part_size
    else:
        boot_size = 512 if efi else 1024
        parts.append(part(part_start, boot_size, "fat32", boot_flags, "/boot"))
        root_start, root_size = part_start + boot_size, part_size - boot_size - 1
    parts.append(part(root_start, root_size, "ext4", [], "/"))
    wipe = False
elif efi:
    parts = [part(1, 512, "fat32", ["boot", "esp"], "/boot"),
             part(513, total_mib - 513 - 1, "ext4", [], "/")]
    wipe = True
else:
    parts = [part(1, 1024, "fat32", ["boot"], "/boot"),
             part(1025, total_mib - 1025 - 1, "ext4", [], "/")]
    wipe = True

# Sadece dosya yazan yer tutucu komutlar (":") logda goremeyelim.
commands = [c for c in commands if c.strip() != ":"]

config = {
    # Eski şema ("bootloader") ve yeni şema ("bootloader_config"): archinstall bilmediğini yok sayar.
    "bootloader": "Grub",
    "bootloader_config": {"bootloader": "Grub", "uki": False, "removable": True},
    "hostname": E["H_HOST"],
    "packages": list(dict.fromkeys(packages)),
    "custom_commands": commands,
    "timezone": E["H_TZ"] or "UTC",
    "locale_config": {"kb_layout": E["H_KB"], "sys_lang": "en_US", "sys_enc": "UTF-8"},
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": [{"device": E["H_DISK"], "partitions": parts, "wipe": wipe}],
    },
}
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(config, f, indent=2, ensure_ascii=False)

# Dosya kopyalandiktan sonra chroot icinde calistirilacak kucuk islemler.
with open(POST, "w", encoding="utf-8") as f:
    f.write("#!/bin/bash\nset -u\n" + "\n".join(post_actions) + "\n")
os.chmod(POST, 0o755)
PY
}

# Marka dosyalarini archinstall config'ine base64 olarak gommek yerine live
# sistemde hazirladik; kurulum bitince kok bolumu yazilabilir baglayip cp -a ile
# hedef sisteme kopyalariz. Boylece kurulum logunda base64 yigitlari akmz.
apply_branding() {
  local staging="/tmp/horos-branding" post="/tmp/horos-post-actions.sh"
  local m p root="" rc=0 attempt
  local parts=()
  [[ -d "$staging" ]] || { rm -f "$post"; return 0; }

  echo
  echo "HorOS marka dosyalari yerlestiriliyor..."
  swapoff -a 2>/dev/null || true
  udevadm settle 2>/dev/null || true
  umount -R /mnt 2>/dev/null || true

  mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part"{print $1}')
  m="$(mktemp -d /tmp/horos-brand.XXXXXX)"
  for p in "${parts[@]}"; do
    mount -o ro "$p" "$m" 2>/dev/null || continue
    if [[ -f "$m/etc/fstab" && -d "$m/usr" ]]; then root="$p"; fi
    umount "$m" 2>/dev/null || true
    [[ -n "$root" ]] && break
  done
  if [[ -z "$root" ]]; then
    echo "${R}UYARI:${N} kok bolum bulunamadi, marka dosyalari kopyalanamadi."
    rmdir "$m" 2>/dev/null || true
    rm -rf "$staging" "$post"
    return 1
  fi

  for attempt in 1 2 3; do
    umount -R "$m" 2>/dev/null || true
    if mount -o rw "$root" "$m" 2>/dev/null; then rc=0; break; fi
    rc=1; sleep 1
  done
  if (( rc != 0 )); then
    echo "${R}UYARI:${N} kok bolum ($root) yazilabilir baglanamadi."
    rmdir "$m" 2>/dev/null || true
    rm -rf "$staging" "$post"
    return 1
  fi

  cp -a "$staging/." "$m/" || rc=1
  if [[ -f "$post" ]]; then
    HOROS_ROOT="$m" bash "$post" || true
  fi
  umount "$m" 2>/dev/null || rc=1
  rmdir "$m" 2>/dev/null || true
  rm -rf "$staging" "$post"
  (( rc == 0 )) && echo "${G}Marka dosyalari kuruldu.${N}"
  return "$rc"
}

# Kurulum bitince diski salt-okunur bağlayıp çekirdek, initramfs ve önyükleyici dosyalarını arar.
verify_boot() {
  local m mount_err rc attempt efi=0 parts=() boot root problems=()
  [[ -d /sys/firmware/efi ]] && efi=1

  # archinstall'in chroot'unda açılan swapfile live ortamda hâlâ aktif kalabilir.
  # Bu, /mnt'in tamamen kapanmasını ve kökün başka yere ro mount edilmesini engeller.
  swapoff -a 2>/dev/null || true
  udevadm settle 2>/dev/null || true
  umount -R /mnt 2>/dev/null || true

  mapfile -t parts < <(lsblk -lnpo NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part"{print $1}')
  if (( ${#parts[@]} < 2 )); then
    echo "${R}UYARI:${N} $disk üzerinde beklenen bölümler bulunamadı."; return 1
  fi
  m="$(mktemp -d /tmp/horos-verify.XXXXXX)"
  mount_err="$(mktemp /tmp/horos-verify-mount.XXXXXX)"

  if [[ "$disk_mode" == "partial" ]]; then
    # Kısmi kurulumda bölüm sırası değişir; kökü ve boot'u içeriğinden bul.
    local p candidate=""
    for p in "${parts[@]}"; do
      mount -o ro "$p" "$m" 2>/dev/null || continue
      if [[ -d "$m/EFI" || -f "$m/grub/grub.cfg" ]]; then candidate="$p"; fi
      umount "$m" 2>/dev/null || true
    done
    boot="$candidate"
    root=""
    for p in "${parts[@]}"; do
      mount -o ro "$p" "$m" 2>/dev/null || continue
      if [[ -f "$m/etc/fstab" && -d "$m/usr" ]]; then root="$p"; fi
      umount "$m" 2>/dev/null || true
    done
    [[ -z "$root" ]] && root="${parts[-1]}"
    [[ -z "$boot" ]] && boot="$root"
  else
    # Tam disk modunda ilk bölüm /boot, son bölüm kök.
    boot="${parts[0]}"; root="${parts[-1]}"
  fi

  # Bölüm tablosu/udev birkaç saniye gecikebiliyor; kısa bir retry yeterli.
  rc=1
  for attempt in 1 2 3; do
    swapoff -a 2>/dev/null || true
    umount -R "$m" 2>/dev/null || true
    if mount -o ro "$root" "$m" 2>"$mount_err"; then rc=0; break; fi
    sleep 1
  done
  if (( rc != 0 )); then
    echo "${R}UYARI:${N} kök bölüm ($root) bağlanamadı: $(tr '\n' ' ' < "$mount_err")"
    rm -f "$mount_err"; rmdir "$m" 2>/dev/null || true
    return 1
  fi

  mkdir -p "$m/boot"
  mount -o ro "$boot" "$m/boot" 2>/dev/null || problems+=("boot bölümü ($boot) bağlanamadı")
  [[ -s "$m/boot/vmlinuz-linux" ]]        || problems+=("çekirdek yok (/boot/vmlinuz-linux)")
  [[ -s "$m/boot/initramfs-linux.img" ]]  || problems+=("initramfs yok (/boot/initramfs-linux.img)")
  [[ -f "$m/boot/grub/grub.cfg" || -f "$m/boot/loader/loader.conf" ]] \
    || problems+=("önyükleyici yapılandırması yok (grub.cfg)")
  if (( efi )); then
    find "$m/boot/EFI" -iname '*.efi' 2>/dev/null | grep -q . || problems+=("EFI önyükleyici dosyası yok")
  else
    [[ -f "$m/boot/grub/i386-pc/core.img" ]] || problems+=("GRUB (BIOS) core.img yok")
  fi

  umount -R "$m" 2>/dev/null || true
  swapoff -a 2>/dev/null || true
  rm -f "$mount_err"
  rmdir "$m" 2>/dev/null || true

  if (( ${#problems[@]} > 0 )); then
    echo "${R}Önyükleme doğrulaması başarısız:${N}"
    printf '  - %s\n' "${problems[@]}"
    echo "Kayıt: /var/log/archinstall/install.log"
    return 1
  fi
  echo "${G}Önyükleme doğrulandı:${N} çekirdek, initramfs ve önyükleyici yerinde."
  return 0
}

begin_install() {
  local missing=()
  [[ -z "$disk" ]] && missing+=("Kurulum hedefi")
  admin_ok || missing+=("Yönetici hesap (kullanıcı oluştur veya root parolası belirle)")
  if [[ -z "$DRYRUN" ]]; then
    echo "Ağ denetleniyor..."
    if have_net; then net_state="Bağlı"; else net_state="Bağlı değil"; missing+=("İnternet bağlantısı (7 numaralı maddeden ağı ayarla)"); fi
  fi
  if (( ${#missing[@]} > 0 )); then
    echo
    echo "${R}Önce tamamlanması gerekenler:${N}"
    printf '  - %s\n' "${missing[@]}"
    pause 3
    return 99
  fi

  # AI-native kurulum: provider seçimi kullanıcıya mutlaka sorulur (madde 5'ten değiştirilebilir).
  if (( ! limon_asked )); then set_limon; fi

  echo
  echo "${Y}Kurulacak sistem${N}"
  echo "  Profil      : $(profile_title "$profile")"
  echo "  Masaüstü    : $(desktop_label)"
  if [[ "$disk_mode" == "partial" ]]; then
    echo "  Disk        : $disk ($(human_size "$disk_bytes")) — ${G}${partial_size} MiB alan, mevcut bölümler korunur${N}"
  else
    echo "  Disk        : $disk ($(human_size "$disk_bytes")) — ${R}TÜM VERİLER SİLİNECEK${N}"
  fi
  echo "  Takas       : $(swap_label)"
  echo "  Sürücüler   : $driver_note"
  echo "  Önyükleme   : $([[ -d /sys/firmware/efi ]] && echo UEFI || echo BIOS)"
  echo "  Makine adı  : $hostname_v   Saat dilimi: $timezone   Klavye: $kb   Dil: en_US.UTF-8"
  echo "  Kullanıcı   : ${username:-yok}$( ((user_admin)) && [[ -n "$username" ]] && echo ' (sudo)')   Root: $([[ -n "$root_hash" ]] && echo parolalı || echo kilitli)"
  echo "  limon       : $(limon_label)"
  echo
  local answer
  read -rp "Devam etmek için INSTALL yaz: " answer || return 1
  if [[ "$answer" != "INSTALL" ]]; then
    echo "Vazgeçildi."; pause; return 99
  fi

  local cfg
  cfg="$(mktemp --suffix=.json /tmp/horos-archinstall.XXXXXX)"
  if ! generate_config "$cfg"; then
    echo "HATA: yapılandırma üretilemedi." >&2
    rm -f "$cfg"; return 1
  fi

  if [[ -n "$DRYRUN" ]]; then
    echo "DRYRUN: yapılandırma yazıldı, kurulum yapılmadı: $cfg"
    return 0
  fi

  echo
  prepare_pacman || { rm -f "$cfg"; return 1; }
  umount -R /mnt 2>/dev/null || true
  swapoff -a 2>/dev/null || true

  echo
  echo "Kurulum başlıyor..."
  local rc=0
  archinstall --config "$cfg" --silent || rc=$?
  rm -f "$cfg"
  if (( rc == 0 )); then
    apply_branding || rc=4
  fi
  if (( rc == 0 )); then
    echo
    verify_boot || rc=3
  fi
  return "$rc"
}

# ---------------------------------------------------------------- ana akış
main() {
  if [[ $EUID -ne 0 ]]; then
    echo "Kurulum aracı root olarak çalıştırılmalı."; exit 1
  fi
  if [[ -z "$DRYRUN" ]] && ! command -v archinstall >/dev/null; then
    echo "archinstall bulunamadı." >&2; exit 1
  fi

  # Varsayılan profil: ilk klasör
  profile="$(find "$PROFILE_DIR" -mindepth 1 -maxdepth 1 -type d ! -name common -printf '%f\n' 2>/dev/null | sort | head -n1)"
  if [[ -z "$profile" ]]; then
    echo "Profil dizini bulunamadı: $PROFILE_DIR" >&2; exit 1
  fi

  # Ekran hemen açılır: ağ/konum tespiti arka planda, klavye parola yazılmadan önce onaylanır.
  trap '[[ -n "$DETECT_DIR" ]] && rm -rf "$DETECT_DIR"' EXIT
  kb=us
  swap_mib="$(swap_size_for_ram)"
  detect_drivers
  start_detect

  local c rc st buf="" redraw=1 targs
  while true; do
    if (( redraw )); then show_hub; printf 'Seçim: '; buf=""; fi
    redraw=1
    targs=(); (( detect_done )) || targs=(-t 1)
    read -r "${targs[@]}" c; st=$?
    if (( st > 128 )); then          # zaman aşımı: yazılmakta olan girdiyi koru
      buf+="$c"
      if apply_detect; then redraw=1; else redraw=0; fi
      continue
    fi
    if (( st != 0 )); then sleep 1; continue; fi
    c="$buf$c"; buf=""
    case "$c" in
      1) set_keyboard ;;
      2) set_timezone ;;
      3) set_profile ;;
      4) set_desktop ;;
      5) set_limon ;;
      6) set_disk ;;
      7) set_network ;;
      8) set_root ;;
      9) set_user ;;
      10) set_swap ;;
      b|B) begin_install; rc=$?
           (( rc == 99 )) && continue
           return "$rc" ;;
      q|Q) echo "Vazgeçildi."; exit 130 ;;
      *) echo "Geçersiz seçim."; pause ;;
    esac
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
