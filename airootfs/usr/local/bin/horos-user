#!/usr/bin/env bash
# HorOS Linux — Live ortamında normal kullanıcı oluşturur
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Bu işlem root gerektirir. Live ISO'da root oturumunda çalıştır."
  exit 1
fi

while true; do
  read -rp "Yeni kullanıcı adı: " username
  if [[ ! "$username" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo "Geçersiz kullanıcı adı (küçük harf, rakam, _ ve - kullan)."
  elif id "$username" &>/dev/null; then
    echo "Bu kullanıcı zaten var."
  else
    break
  fi
done

while true; do
  read -rsp "Parola: " password; echo
  read -rsp "Parolayı tekrar gir: " confirm; echo
  if [[ -n "$password" && "$password" == "$confirm" ]]; then
    break
  fi
  echo "Parolalar boş olamaz ve eşleşmelidir."
done

getent group wheel >/dev/null || groupadd -r wheel
useradd -m -G wheel -s /bin/bash "$username"
printf '%s:%s\n' "$username" "$password" | chpasswd
unset password confirm

install -d -m 0750 /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/10-wheel
chmod 0440 /etc/sudoers.d/10-wheel
visudo -cf /etc/sudoers.d/10-wheel >/dev/null

echo "Kullanıcı '$username' oluşturuldu (sudo yetkili)."
echo "Giriş için: su - $username"
echo "Live ortamındaki değişiklikler yeniden başlatınca silinir."
